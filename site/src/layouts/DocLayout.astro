---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocsSearch from '../components/DocsSearch.astro';
import { buildBreadcrumbList } from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  lastmod?: string;
}

const { title, description, keywords, lastmod } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://zolotukhin.ai';
const metaDescription = description ?? `${title} — ZINC documentation`;
const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'ZINC', href: '/zinc/' },
  { name: 'Docs', href: '/zinc/docs/' },
  { name: title },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: title,
      ...(lastmod ? { dateModified: lastmod } : {}),
      author: {
        '@type': 'Organization',
        name: 'ZINC Project',
      },
      description: metaDescription,
      url: Astro.url.href,
      mainEntityOfPage: Astro.url.href,
    },
    buildBreadcrumbList(siteUrl, breadcrumbItems),
  ],
};

const docNavSections = [
  {
    label: 'Start Here',
    items: [
      { slug: 'getting-started', label: 'Getting Started' },
      { slug: 'hardware-requirements', label: 'Hardware Requirements' },
      { slug: 'rocm', label: 'AMD ROCm Setup' },
      { slug: 'running-zinc', label: 'Running ZINC' },
      { slug: 'api', label: 'Serving HTTP API' },
      { slug: 'development', label: 'Development' },
    ],
  },
  {
    label: 'Engineering',
    items: [
      { slug: 'spec', label: 'Technical Spec' },
      { slug: 'rdna4-tuning', label: 'RDNA4 Tuning' },
      { slug: 'amd-gpu-reference', label: 'AMD GPU' },
      { slug: 'nvidia-gpu-reference', label: 'NVIDIA GPU' },
      { slug: 'intel-gpu-reference', label: 'Intel GPU' },
      { slug: 'turboquant-spec', label: 'TurboQuant' },
      { slug: 'apple-silicon-reference', label: 'Apple Silicon' },
      { slug: 'apple-metal-reference', label: 'Apple Metal' },
      { slug: 'zig-api', label: 'Zig API' },
    ],
  },
];

const currentSlug = Astro.url.pathname.replace('/zinc/docs/', '').replace(/\/$/, '');

function isActive(slug: string): boolean {
  return currentSlug === slug || currentSlug.startsWith(`${slug}/`);
}
---

<BaseLayout title={title} description={metaDescription} keywords={keywords} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="doc-layout wide">
    <aside class="doc-nav">
      <input type="checkbox" id="doc-nav-toggle" class="doc-nav-checkbox sr-only" aria-label="Browse documentation" />
      <div class="doc-nav-bar">
        <h3><a href="/zinc/docs/">Docs</a></h3>
        <label for="doc-nav-toggle" class="doc-nav-toggle-label" aria-label="Toggle docs navigation">
          <span></span>
        </label>
      </div>
      <div class="doc-nav-panel">
        <DocsSearch compact={true} heading="Search" intro="Search guides and the Zig API." placeholder="Search docs and API" />
        {docNavSections.map(section => (
          <div class="doc-nav-section">
            <p class="doc-nav-label">{section.label}</p>
            <ul>
              {section.items.map(item => (
                <li>
                  <a href={`/zinc/docs/${item.slug}/`} aria-current={isActive(item.slug) ? 'page' : undefined} class:list={[{ active: isActive(item.slug) }]}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>
    <article class="doc-content">
      {lastmod && <p class="lastmod">Last updated: {lastmod}</p>}
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .doc-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-xl);
    max-width: 1220px;
    margin: 0 auto;
  }

  .wide {
    width: 100vw;
    max-width: 1220px;
    margin-left: calc(50% - min(50vw, 610px));
    padding: 0 var(--space-md);
  }

  .doc-nav h3 {
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .doc-nav h3 a {
    color: var(--color-text);
  }

  .doc-nav {
    position: sticky;
    top: 1rem;
    align-self: start;
  }

  .doc-nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* The collapse toggle only appears on mobile; desktop shows the full panel. */
  .doc-nav-toggle-label {
    display: none;
    cursor: pointer;
    padding: var(--space-sm);
    margin: calc(-1 * var(--space-sm));
  }

  .doc-nav-toggle-label span,
  .doc-nav-toggle-label span::before,
  .doc-nav-toggle-label span::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-text-muted);
    position: relative;
  }

  .doc-nav-toggle-label span::before,
  .doc-nav-toggle-label span::after {
    content: '';
    position: absolute;
  }

  .doc-nav-toggle-label span::before { top: -5px; }
  .doc-nav-toggle-label span::after { top: 5px; }

  .doc-nav-section + .doc-nav-section {
    margin-top: var(--space-lg);
  }

  .doc-nav-label {
    margin: 0 0 var(--space-xs);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .doc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .doc-nav li {
    margin-bottom: var(--space-xs);
  }

  .doc-nav a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .doc-nav a:hover,
  .doc-nav a.active {
    color: var(--color-accent);
    text-decoration: none;
  }

  .lastmod {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .doc-content {
    min-width: 0;
  }

  .doc-content :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  .doc-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  .doc-nav-checkbox:focus-visible ~ .doc-nav-bar .doc-nav-toggle-label {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Markdown descendants do not carry this component's scoped attribute. */
  .doc-content :global(:is(h1, h2, h3, h4, h5, h6)) {
    scroll-margin-top: 1.25rem;
  }

  .doc-content :global(.heading-anchor) {
    margin-left: 0.45rem;
    color: var(--color-text-muted);
    opacity: 0;
    font-size: 0.8em;
    text-decoration: none;
    transition: opacity 0.12s ease;
  }

  .doc-content :global(:is(h1, h2, h3, h4, h5, h6):hover .heading-anchor),
  .doc-content :global(:is(h1, h2, h3, h4, h5, h6):focus-within .heading-anchor),
  .doc-content :global(.heading-anchor:focus) {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .doc-layout {
      grid-template-columns: 190px minmax(0, 1fr);
      max-width: 1080px;
    }

    .wide {
      max-width: 1080px;
      margin-left: calc(50% - min(50vw, 540px));
    }
  }

  @media (max-width: 700px) {
    .doc-layout {
      grid-template-columns: 1fr;
    }

    .doc-nav {
      position: static;
    }

    /* Collapse the doc nav into a tappable "Docs" bar so the article is the
       first thing visible; the link list expands on demand. */
    .doc-nav-toggle-label {
      display: block;
    }

    .doc-nav-panel {
      display: none;
    }

    .doc-nav-checkbox:checked ~ .doc-nav-panel {
      display: block;
      margin-top: var(--space-md);
    }

    .doc-nav ul {
      display: flex;
      gap: var(--space-md);
      flex-wrap: wrap;
    }
  }
</style>
