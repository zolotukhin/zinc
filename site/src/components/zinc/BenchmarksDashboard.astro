---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import CommitReference from './CommitReference.astro';
import type { BenchmarkRecord } from '../../lib/benchmark-view';
import { buildBreadcrumbList } from '../../lib/structured-data';
import benchmarkData from '../../data/zinc-performance.json';
import {
  aggregate, backendLabel, barWidth, formatDate, formatNumber, formatRatio,
  hasMtpVariants, metric, overallRatio, phaseSeconds, platformLabel, promptParity,
  qualityStatus, rateRatio, rowsFor, sampleCount, scenarioNames, scenarioOrder,
  scenarios, sourceUrl,
} from '../../lib/benchmark-view';

interface Props { pagePath?: string; canonicalPath?: string; }
const { canonicalPath = '/zinc/benchmarks/' } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://zolotukhin.ai';
const breadcrumbItems = [{ name: 'Home', href: '/' }, { name: 'ZINC', href: '/zinc/' }, { name: 'Benchmarks' }];
const order = ['rdna-rocm', 'rdna', 'intel', 'metal', 'cuda'];
const rank = (id: string) => order.includes(id) ? order.indexOf(id) : order.length;
const targets = ([...benchmarkData.targets] as BenchmarkRecord[]).sort((a, b) => rank(a.id) - rank(b.id));
const modelCount = new Set(targets.flatMap((target) => target.models.map((model) => model.id))).size;
// Ratios use a unit scale: 1.00 means parity. Keep CSS tone selection with the view.
function ratioTone(value: number | null) {
  return value == null ? 'neutral' : value >= 1 ? 'ahead' : 'behind';
}
function measuredRuns(methodology: BenchmarkRecord) {
  const min = methodology.runs_min ?? methodology.runs ?? methodology.runs_max;
  const max = methodology.runs_max ?? methodology.runs ?? min;
  return min == null ? 'Not recorded' : min === max ? String(min) : `${min}–${max}`;
}
const keywords = 'ZINC benchmarks, llama.cpp comparison, ROCm, Vulkan, Metal, CUDA, Intel Arc, local LLM, prefill throughput, decode throughput, inference latency';
const dataUrl = '/zinc/benchmarks.json';
const guideUrl = '/zinc/docs/benchmarking/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', name: 'ZINC Benchmarks vs llama.cpp', url: `${siteUrl}${canonicalPath}`,
      keywords,
      about: {
        '@type': 'SoftwareApplication', name: 'ZINC', applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Linux, macOS', codeRepository: 'https://github.com/zolotukhin/zinc',
      },
    },
    {
      '@type': 'Dataset', name: 'ZINC benchmark measurements',
      description: 'Recorded same-machine ZINC and llama.cpp prefill, decode, timing, and speculative-decoding measurements.',
      dateModified: benchmarkData.generated_at,
      creator: { '@type': 'Person', name: 'Stepan Zolotukhin', url: `${siteUrl}/about/` },
      license: 'https://opensource.org/licenses/MIT', isAccessibleForFree: true,
      distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${siteUrl}${dataUrl}` },
    },
    buildBreadcrumbList(siteUrl, breadcrumbItems),
  ],
};
---

<BaseLayout
  title="ZINC Benchmarks vs llama.cpp"
  description="Compare ZINC and llama.cpp on the same GPU and GGUF: explicit backends, recorded commits, prompts, timings, and downloadable benchmark data."
  keywords={keywords}
  canonicalUrl={`${siteUrl}${canonicalPath}`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="benchmarks" data-benchmarks>
    <header class="hero">
      <p class="eyebrow">ZINC · Performance</p>
      <h1>Benchmarks</h1>
      <p class="intro">ZINC and llama.cpp, on the same GPU and model file. Compare prompt processing and token generation, with the backend and evidence beside every result.</p>
      <div class="hero-meta">
        <span>{targets.length} backend runs</span><span>{modelCount} models</span>
        <span>Latest measurement: <time datetime={benchmarkData.generated_at}>{formatDate(benchmarkData.generated_at)}</time></span>
      </div>
      <nav class="resource-links" aria-label="Benchmark resources">
        <a href={guideUrl}>How to reproduce <span aria-hidden="true">↗</span></a>
        <a href={dataUrl} download="zinc-benchmarks.json">Download JSON <span aria-hidden="true">↓</span></a>
        <a href={sourceUrl(null, 'tools/performance_suite.mjs')}>Benchmark runner <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <details class="reading-guide">
      <summary>How to read these results</summary>
      <div class="guide-grid">
        <p><strong>Prefill</strong> is prompt processing; <strong>decode</strong> is output generation. Both use tokens per second (tok/s); higher is faster. Bar lengths share a scale within each phase and workload.</p>
        <p><strong>1.00×</strong> is llama.cpp’s rate. A ratio above 1.00× favors ZINC; below it favors llama.cpp. The overall ratio divides llama.cpp’s combined prefill and decode time by ZINC’s, using rows with matching prompt and output budgets.</p>
        <p>Rates are medians of the recorded runs. Summaries average model medians; the overall summary uses summed phase times. Request latency is shown separately and may include HTTP, startup, or model loading, depending on the recorded protocol.</p>
        <p>These are historical measurements, not a live leaderboard. Platforms have different dates and protocols. Flagged output, early stops, missing telemetry, and different prompt counts are excluded from the overall summary. An output preview is a sanity check, not a quality evaluation.</p>
      </div>
    </details>

    <section class="platform-picker" aria-labelledby="platform-heading">
      <div class="section-heading"><span class="step">01</span><h2 id="platform-heading">Choose a platform &amp; backend</h2></div>
      <div class="target-tabs" role="tablist" aria-label="Benchmark platform and backend">
        {targets.map((target, index) => {
          const coverage = aggregate(rowsFor(target, 'core', 'off'));
          return (
          <button type="button" role="tab" id={`tab-${target.id}`} aria-controls={target.id}
            aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}
            class:list={['target-tab', { active: index === 0 }]} data-bench-target-tab={target.id}>
            <span class="tab-identity">{platformLabel(target)} <b class={`backend-badge ${target.id}`}>{backendLabel(target)}</b></span>
            <span class="tab-gpu">{target.machine?.gpu ?? 'GPU not recorded'}</span>
            <span class="tab-date">{formatDate(target.generated_at)}</span>
            <span class="tab-coverage">Quick chat: {coverage.comparable}/{coverage.total} comparable{hasMtpVariants(target) ? ' · MTP off' : ''}</span>
          </button>
        );})}
      </div>
    </section>

    <noscript><p class="notice">All platforms and workloads are shown below. Enable JavaScript to filter results or share a selected view.</p></noscript>

    {targets.map((target) => {
      const methodology = target.methodology ?? {};
      const machine = target.machine ?? {};
      const notes = Array.isArray(methodology.notes) ? methodology.notes : [];
      const provenance = target.provenance ?? {};
      const zincSource = sourceUrl(provenance.zinc?.commit, 'tools/performance_suite.mjs');
      const scenarioIds = scenarioOrder.filter((id) => target.models.some((model) => scenarios(model).some((scenario) => scenario.id === id)));
      const supportsMtp = hasMtpVariants(target);
      const modes = supportsMtp ? ['off', 'on'] as const : ['off'] as const;
      const historicalCli = /ZINC CLI/i.test(methodology.runner ?? '');
      const protocol = historicalCli ? 'ZINC CLI vs llama.cpp (historical)' : /server/i.test(methodology.runner ?? '') ? 'Server protocol (CLI fallback allowed)' : 'Protocol not recorded';
      return (
        <section id={target.id} class="target-panel" role="tabpanel" aria-labelledby={`tab-${target.id}`}
          tabindex="0" data-bench-target-panel={target.id} data-default-scenario={scenarioIds[0]}>
          <header class="panel-header">
            <div>
              <p class="eyebrow">{platformLabel(target)}</p>
              <h2>{machine.gpu ?? 'GPU not recorded'}</h2>
              <p class="hardware">{machine.memory ?? 'Memory not recorded'} · {machine.os ?? 'OS not recorded'}</p>
              <p class="backend-comparison"><strong>ZINC: {methodology.zinc_backend?.replace(/\bROCM\b/g, 'ROCm') ?? 'Not recorded'}</strong><span aria-hidden="true">/</span><strong>llama.cpp: {methodology.llama_backend ?? 'Not recorded'}</strong></p>
              <p class="run-meta"><time datetime={target.generated_at}>{formatDate(target.generated_at)}</time> · {protocol} · {measuredRuns(methodology)} measured · {methodology.warmup_runs ?? 'Not recorded'} warmup</p>
            </div>
            <button type="button" class="share-button" data-bench-share>Copy link to this view</button>
          </header>

          {historicalCli && <p class="notice"><strong>Historical CLI measurements.</strong> ZINC ran through its CLI; the baseline preferred a reusable llama.cpp server, with a CLI fallback. Phase rates are useful diagnostics. Request latency and these protocols should not be treated as a fair server-to-server comparison.</p>}

          <details class="configuration">
            <summary>Exact configuration &amp; methodology</summary>
            <div class="configuration-body">
              <dl class="config-grid">
                <div><dt>ZINC backend</dt><dd>{methodology.zinc_backend?.replace(/\bROCM\b/g, 'ROCm') ?? 'Not recorded'}</dd></div>
                <div><dt>llama.cpp backend</dt><dd>{methodology.llama_backend ?? 'Not recorded'}</dd></div>
                <div><dt>Recorded llama.cpp device</dt><dd><code>{methodology.llama_device ?? 'Not recorded'}</code></dd></div>
                <div><dt>Protocol</dt><dd>{methodology.runner ?? 'Not recorded'}</dd></div>
                <div><dt>ZINC commit</dt><dd><CommitReference project="zinc" provenance={provenance.zinc} /></dd></div>
                <div><dt>llama.cpp commit</dt><dd><CommitReference project="llama.cpp" provenance={provenance.llama_cpp} />{provenance.llama_cpp?.version && <small>Version {provenance.llama_cpp.version}</small>}</dd></div>
                <div class="full-width"><dt>Recorded ZINC build</dt><dd><code>{methodology.zinc_build ?? 'Not recorded'}</code></dd></div>
                {provenance.llama_cpp?.sha256 && <div class="full-width"><dt>llama.cpp binary SHA-256</dt><dd><code>{provenance.llama_cpp.sha256}</code></dd></div>}
              </dl>
              <p class="config-note">These are the recorded settings. Model details below carry their own dates and commits when available. Missing metadata is labeled explicitly; older artifacts do not record every driver version, build flag, or model checksum.</p>
              <nav class="resource-links" aria-label={`${backendLabel(target)} reproducibility sources`}>
                <a href={zincSource}>{provenance.zinc?.commit ? 'Runner at recorded revision' : 'Current runner (revision not recorded)'}</a>
                <a href={sourceUrl(provenance.zinc?.commit, 'src/model/catalog.zig')}>{provenance.zinc?.commit ? 'Model catalog at revision' : 'Current model catalog'}</a>
                {target.id.startsWith('rdna') && <a href="https://www.amd.com/content/dam/amd/en/documents/partner-hub/radeon-pro/radeon-ai-pro-r9700-datasheet.pdf">AMD GPU specification</a>}
                <a href={guideUrl}>Reproduction guide</a>
                <a href={dataUrl}>Published data &amp; samples</a>
              </nav>
              <ul class="method-notes">{notes.map((note) => <li>{note}</li>)}</ul>
            </div>
          </details>

          {supportsMtp && <div class="mtp-control">
            <div><strong>Speculative decoding (MTP)</strong><p>Off shows both engines without speculation. On uses ZINC’s measured NextN/MTP run for supported models; llama.cpp remains without speculation.</p></div>
            <div class="segmented" role="group" aria-label="ZINC speculative decoding">
              <button type="button" data-mtp-mode="off" aria-pressed="true">Off</button>
              <button type="button" data-mtp-mode="on" aria-pressed="false">On</button>
            </div>
          </div>}

          <div class="workload-picker">
            <div class="section-heading"><span class="step">02</span><h3>Choose a workload</h3></div>
            <div class="scenario-tabs" role="group" aria-label={`${platformLabel(target)} ${backendLabel(target)} workloads`}>
              {scenarioIds.map((id, index) => <button type="button" data-bench-scenario={id} aria-pressed={index === 0 ? 'true' : 'false'}>{scenarioNames[id]}</button>)}
            </div>
          </div>

          {modes.map((mode) => <div class="mode-panel" data-bench-mode-panel={mode}>
            {scenarioIds.map((scenarioId) => {
              const rows = rowsFor(target, scenarioId, mode);
              const summary = aggregate(rows);
              const phaseMax = (phase: string) => Math.max(0, ...rows.flatMap((row) => [metric(row.zinc?.[phase]) ?? 0, metric(row.baseline?.[phase]) ?? 0]));
              return (
                <section class="scenario-panel" data-bench-scenario-panel={scenarioId} aria-label={`${scenarioNames[scenarioId]}, MTP ${mode}`}>
                  <header class="results-heading">
                    <h3>{scenarioNames[scenarioId]}</h3>
                    <p>{supportsMtp ? `ZINC MTP ${mode} · llama.cpp MTP off` : 'No speculative decoding recorded'} · {summary.completed}/{summary.total} completed</p>
                  </header>
                  <div class="summary-grid" aria-label="Workload summary">
                    <div><span>Average prefill</span><strong data-summary="prefill">{formatNumber(summary.prefill)} <small>tok/s</small></strong><p>Mean of ZINC model medians</p></div>
                    <div><span>Average decode</span><strong data-summary="decode">{formatNumber(summary.decode)} <small>tok/s</small></strong><p>Mean of ZINC model medians</p></div>
                    <div><span>Overall vs llama.cpp</span><strong data-summary="overall" class={ratioTone(summary.overall)}>{summary.overall == null ? '—' : formatRatio(summary.overall)}</strong><p>{summary.comparable} comparable model{summary.comparable === 1 ? '' : 's'} · prefill + decode</p></div>
                  </div>
                  <div class="chart-caption"><p>Tokens per second · higher is faster</p><p><i class="swatch zinc"></i> ZINC <i class="swatch llama"></i> llama.cpp</p></div>
                  <div class="model-list">
                    {rows.map((row) => {
                      const ratio = overallRatio(row);
                      const parity = promptParity(row);
                      const quality = qualityStatus(row);
                      const zincCount = sampleCount(row.zinc?.decode_tps);
                      const llamaCount = sampleCount(row.baseline?.decode_tps);
                      const spec = row.zinc?.speculative_decoding;
                      const zincProvenance = row.provenance?.zinc;
                      const llamaProvenance = row.provenance?.llama_cpp;
                      const warning = row.zinc?.unavailable_reason ?? row.baseline?.unavailable_reason;
                      return (
                        <article class="model-card" data-bench-model={row.model.id}>
                          <div class="model-chart">
                            <header class="model-heading"><h4>{row.model.label}</h4><p><code>{row.model.quant}</code> · {formatDate(row.measured_at)}</p>{spec?.enabled && <span class="mtp-badge">ZINC MTP on</span>}</header>
                            {(['prefill_tps', 'decode_tps'] as const).map((phase) => {
                              const zinc = metric(row.zinc?.[phase]);
                              const llama = metric(row.baseline?.[phase]);
                              const phaseRatio = rateRatio(row, phase);
                              return <div class="phase" data-phase={phase}>
                                <div class="phase-title"><h5>{phase === 'prefill_tps' ? 'Prefill' : 'Decode'}</h5><span class:list={['rate-ratio', parity === false || quality.tone === 'caution' ? 'neutral' : ratioTone(phaseRatio)]}>{phaseRatio == null ? 'Not recorded' : formatRatio(phaseRatio)}</span></div>
                                {([['zinc', zinc], ['baseline', llama]] as const).map(([engine, value]) => <div class="bar-line">
                                  <span>{engine === 'zinc' ? 'ZINC' : 'llama.cpp'}</span><div class="bar-track" aria-hidden="true"><i class:list={['bar-fill', engine === 'zinc' ? 'zinc' : 'llama']} style={`width: ${barWidth(value, phaseMax(phase))}%`}></i></div><strong data-engine={engine}>{value == null ? '—' : formatNumber(value)}</strong>
                                </div>)}
                              </div>;
                            })}
                            <div class="overall-result"><span>Overall</span><strong class={ratioTone(ratio)} data-overall>{formatRatio(ratio)}</strong></div>
                          </div>
                          {(warning || parity === false || quality.tone === 'caution' || (ratio == null && !warning)) && <p class="row-note">{warning ? 'A measurement is unavailable. See the published data for the recorded failure.' : quality.tone === 'caution' ? `${quality.note} Excluded from the overall comparison.` : parity === false ? 'Different prompt token counts. Per-token rates are indicative; excluded from the overall comparison.' : 'Output budgets differ, a run stopped early, or phase telemetry is incomplete. Excluded from the overall comparison.'}</p>}
                          <details class="row-evidence">
                            <summary>Prompt, timings &amp; source</summary>
                            <div class="evidence-body">
                              <div class="table-scroll" role="region" aria-label="Recorded engine timings" tabindex="0">
                                <table><caption>{row.model.label} · {scenarioNames[scenarioId]} · {row.prompt_mode ?? 'Not recorded'} prompt</caption><thead><tr><th scope="col">Recorded metric</th><th scope="col">ZINC</th><th scope="col">llama.cpp</th></tr></thead><tbody>
                                  <tr><th scope="row">Prompt tokens</th><td>{formatNumber(row.zinc?.prompt_tokens, 0)}</td><td>{formatNumber(row.baseline?.prompt_tokens, 0)}</td></tr>
                                  <tr><th scope="row">Prefill tokens</th><td>{formatNumber(row.zinc?.prefill_tokens ?? row.zinc?.prompt_tokens, 0)}</td><td>{formatNumber(row.baseline?.prefill_tokens ?? row.baseline?.prompt_tokens, 0)}</td></tr>
                                  <tr><th scope="row">Output tokens / requested cap</th><td>{formatNumber(row.zinc?.generated_tokens, 0)} / {row.max_tokens}</td><td>{formatNumber(row.baseline?.generated_tokens, 0)} / {row.max_tokens}</td></tr>
                                  <tr><th scope="row">Measured runs</th><td>{zincCount ?? 'Not recorded'}</td><td>{llamaCount ?? 'Not recorded'}</td></tr>
                                  <tr><th scope="row">Prefill time (ms)</th><td>{formatNumber(metric(row.zinc?.prefill_ms))}</td><td>{formatNumber(metric(row.baseline?.prefill_ms))}</td></tr>
                                  <tr><th scope="row">Decode time per token (ms)</th><td>{formatNumber(metric(row.zinc?.ms_per_token))}</td><td>{formatNumber(metric(row.baseline?.ms_per_token))}</td></tr>
                                  <tr><th scope="row">Combined phase time (s, derived)</th><td>{formatNumber(phaseSeconds(row.zinc), 3)}</td><td>{formatNumber(phaseSeconds(row.baseline), 3)}</td></tr>
                                  <tr><th scope="row">Request latency (ms)</th><td>{formatNumber(metric(row.zinc?.total_latency_ms), 0)}</td><td>{formatNumber(metric(row.baseline?.total_latency_ms), 0)}</td></tr>
                                  <tr><th scope="row">Source commit</th><td><CommitReference project="zinc" provenance={zincProvenance} /></td><td><CommitReference project="llama.cpp" provenance={llamaProvenance} /></td></tr>
                                </tbody></table>
                              </div>
                              {spec?.enabled && <p class="config-note">ZINC NextN/MTP accepted {formatNumber(metric(spec.acceptance_pct))}% of drafted tokens. The llama.cpp baseline has no speculative draft model in this artifact.</p>}
                              <h5>Recorded user prompt</h5><pre class="prompt" tabindex="0" role="region" aria-label="Recorded user prompt"><code>{row.prompt ?? 'Not recorded'}</code></pre>
                              <p class="config-note">Chat mode also applies the engine’s chat template and harness system message. <a href={sourceUrl(zincProvenance?.commit, 'tools/performance_suite.mjs')}>{zincProvenance?.commit ? 'Read the runner at this revision' : 'Read the current runner (historical revision not recorded)'}</a> for the full request, flags, and warmup policy. Token counts allow a one-token BOS accounting difference.</p>
                              <details class="preview"><summary>Captured ZINC output preview</summary><pre tabindex="0" role="region" aria-label="Captured ZINC output preview"><code>{row.zinc?.output_preview ?? 'Not recorded'}</code></pre></details>
                            </div>
                          </details>
                        </article>
                      );
                    })}
                  </div>
                </section>
              );
            })}
          </div>)}
        </section>
      );
    })}
    <p class="share-status" aria-live="polite" data-share-status></p>
  </div>
  <script>
    import { initBenchmarks } from '../../lib/benchmark-controls';
    initBenchmarks();
  </script>
</BaseLayout>

<style>
  :global(body:has([data-benchmarks])) { --color-accent: #b34700; }
  :global(main.container) { max-width: 1280px; }
  .benchmarks { --zinc: #d05a08; --llama: #326ad1; --muted: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .benchmarks [hidden] { display: none !important; }
  .benchmarks :global(a) { text-decoration: underline; text-underline-offset: .2em; }
  .hero { padding: 1.4rem 0 1.8rem; border-bottom: 1px solid var(--color-border); }
  .eyebrow { margin: 0 0 .55rem; color: var(--color-accent); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .hero h1 { margin: 0 0 .8rem; font-size: clamp(2.6rem, 6vw, 4.3rem); letter-spacing: -.055em; line-height: 1.05; }
  .intro { max-width: 780px; margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }
  .hero-meta, .resource-links { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; font-size: .8rem; }
  .hero-meta { margin-top: 1.1rem; color: var(--muted); }
  .resource-links { margin: 1rem 0 0; }
  .resource-links a { text-decoration: underline; text-underline-offset: .2em; }
  summary { cursor: pointer; font-size: .85rem; font-weight: 600; }
  details > summary { padding: .85rem 0; }
  .reading-guide { margin: .6rem 0 1.8rem; border-bottom: 1px solid var(--color-border); }
  .guide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem 2rem; padding: .4rem 0 1rem; }
  .guide-grid p { margin: 0; font-size: .82rem; line-height: 1.7; color: var(--muted); }
  .guide-grid strong { color: var(--color-text); }
  .section-heading { display: flex; align-items: center; gap: .65rem; margin: 0 0 .8rem; }
  .section-heading h2, .section-heading h3 { margin: 0; font-size: 1rem; letter-spacing: -.02em; }
  .step { font-size: .65rem; color: var(--color-accent); font-weight: 700; }
  button { font: inherit; color: inherit; cursor: pointer; }
  .target-tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .55rem; }
  .target-tab { text-align: left; padding: .9rem .8rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 7px; min-width: 0; }
  .target-tab[aria-selected='true'] { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg)); box-shadow: inset 0 -2px var(--color-accent); }
  .target-tab:hover { border-color: var(--color-accent); }
  .tab-identity { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; font-size: .82rem; font-weight: 650; }
  .backend-badge { padding: .06rem .35rem; border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-accent); background: var(--color-bg); font-size: .65rem; }
  .tab-gpu, .tab-date, .tab-coverage { display: block; margin-top: .45rem; font-size: .7rem; line-height: 1.5; color: var(--muted); }
  .tab-date, .tab-coverage { margin-top: .2rem; }
  .target-panel { padding-top: 2.3rem; scroll-margin-top: 6rem; }
  .panel-header { display: flex; justify-content: space-between; align-items: start; gap: 1.2rem; }
  .panel-header h2 { margin: 0 0 .35rem; font-size: clamp(1.35rem, 3vw, 2rem); letter-spacing: -.035em; }
  .hardware, .run-meta { margin: 0; color: var(--muted); font-size: .8rem; }
  .backend-comparison { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .65rem; margin: .8rem 0 .35rem; font-size: .83rem; }
  .backend-comparison span { color: var(--muted); }
  .share-button { flex: 0 0 auto; padding: .5rem .75rem; border: 1px solid var(--color-border); border-radius: 5px; background: var(--color-bg); font-size: .75rem; }
  .notice, .row-note { margin: 1rem 0; padding: .7rem .85rem; border-left: 3px solid var(--color-accent); background: var(--color-bg-alt); font-size: .8rem; line-height: 1.65; }
  .configuration { margin-top: 1.25rem; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .configuration-body { padding-bottom: 1.2rem; }
  .config-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.4rem; margin: .5rem 0 1rem; }
  .config-grid dt { font-size: .7rem; color: var(--muted); margin-bottom: .2rem; }
  .config-grid dd { margin: 0; font-size: .82rem; overflow-wrap: anywhere; }
