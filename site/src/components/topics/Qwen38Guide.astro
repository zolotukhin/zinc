---
import { Code } from 'astro:components';
import benchmarkData from '../../data/zinc-performance.json';
import { formatDate, formatNumber, metric, rowsFor, scenarioNames, scenarioOrder } from '../../lib/benchmark-view';

const modelId = 'qwen38-27b-q4k-m';
const measurements = ['rdna', 'rdna-rocm'].flatMap((id) => {
  const target = benchmarkData.targets.find((target) => target.id === id);
  if (!target) throw new Error(`Missing Qwen benchmark target: ${id}`);
  return scenarioOrder.map((scenario) => {
    const row = rowsFor(target, scenario, 'off').find((row) => row.model.id === modelId);
    if (!row || row.zinc?.speculative_decoding?.enabled !== false || row.baseline?.speculative_decoding?.enabled !== false) {
      throw new Error(`Qwen guide requires a matched MTP-off measurement: ${id}/${scenario}`);
    }
    return { backend: id === 'rdna' ? 'Vulkan' : 'ROCm', row };
  });
});
const quickstart = [
  'zinc --version',
  'zinc --check',
  'zinc model list --json',
  'zinc model pull qwen38-27b-q4k-m',
  '',
  'ZINC_MTP=0 zinc --model-id qwen38-27b-q4k-m \\',
  '  --context 4096 --chat --max-tokens 256 \\',
  '  --prompt "Explain how a hash table handles collisions."',
].join('\n');
const serve = [
  'ZINC_MTP=0 zinc --model-id qwen38-27b-q4k-m \\',
  '  --context 4096 --parallel 1 --port 9090',
].join('\n');
const discover = [
  'curl --fail http://localhost:9090/health',
  'curl --fail http://localhost:9090/v1/models',
].join('\n');
const themes = { light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' };
---

