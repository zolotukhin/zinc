---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import benchmarkData from '../data/zinc-performance.json';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const rocmTarget = benchmarkData.targets.find((target: any) => target.id === 'rdna-rocm');
const muse = rocmTarget?.models?.find((model: any) => model.id === 'muse-glimmer-30b-q4k-m');
const median = (metric: any) => metric?.median ?? metric?.avg ?? null;
const formatRate = (value: number | null) => value == null ? 'n/a' : value.toFixed(1);
const museDecode = median(muse?.zinc?.decode_tps);
const museLlamaDecode = median(muse?.baseline?.decode_tps);
const musePrefill = median(muse?.zinc?.prefill_tps);
const museLlamaPrefill = median(muse?.baseline?.prefill_tps);
---

<BaseLayout
  title="Stepan Zolotukhin"
  description="I build ZINC, a local LLM inference engine for consumer GPUs, and write about GPU programming and systems engineering."
  keywords="Stepan Zolotukhin, ZINC, LLM inference, consumer GPU inference, AMD GPU, Apple Silicon, NVIDIA RTX, Intel Arc, Vulkan compute, ROCm, Metal, CUDA, Zig, TurboQuant, local AI, GPU programming"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Stepan Zolotukhin',
    url: 'https://zolotukhin.ai',
    description: 'Building ZINC — a local LLM inference engine for consumer GPUs.',
  }}
>
  <section class="hero">
    <h1>Stepan Zolotukhin</h1>
    <p>I'm building <a href="/zinc/">ZINC</a>, a program for running local language models on consumer GPUs. I use this site to publish benchmarks, documentation, and notes about the GPU and systems work behind it.</p>
  </section>

  <section class="project-highlight">
    <article class="project-card">
      <h2>ZINC</h2>
      <p>Run GGUF models on AMD Radeon with Vulkan or ROCm, Intel Arc with Vulkan, or Apple Silicon with Metal. NVIDIA CUDA support is experimental.</p>
      <div class="latest-result">
        <span>Latest ROCm result · Radeon AI PRO R9700</span>
        <strong>Muse Glimmer 30B leads llama.cpp in all four workloads</strong>
        <p>{formatRate(museDecode)} vs {formatRate(museLlamaDecode)} tok/s decode · {formatRate(musePrefill)} vs {formatRate(museLlamaPrefill)} tok/s prefill</p>
      </div>
      <div class="project-links">
        <a href="/zinc/">Read about ZINC &rarr;</a>
        <a href="/zinc/benchmarks/#rdna-rocm">See the benchmark &rarr;</a>
      </div>
    </article>
  </section>

  <section class="recent-posts">
    <h2>Recent posts</h2>
    {posts.map(post => (
      <PostCard
        title={post.data.title}
        date={post.data.date}
        excerpt={post.data.excerpt}
        slug={post.id}
        tags={post.data.tags}
      />
    ))}
    <p class="all-posts"><a href="/blog/">All posts &rarr;</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-xl) 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
  }

  .hero p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 600px;
  }

  .project-highlight {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .project-card {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
  }

  .project-card h2 {
    font-size: 1.3rem;
    margin: 0 0 var(--space-sm);
  }

  .project-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
  }

  .latest-result {
    display: grid;
    gap: 0.3rem;
    margin: var(--space-md) 0;
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .latest-result span {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .latest-result strong {
    font-size: 1rem;
  }

  .latest-result p {
    margin: 0;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .project-links a {
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .recent-posts h2 {
    margin-top: var(--space-xl);
  }

  .all-posts {
    margin-top: var(--space-md);
  }
</style>
