---
import DocLayout from '../../../../layouts/DocLayout.astro';
import { getSourceHref, loadZigApi, type ZigApiMember, type ZigApiModule, type ZigApiSymbol } from '../../../../lib/zig-api-loader';

interface Props {
  apiModule: ZigApiModule;
  lastmod: string;
}

export async function getStaticPaths() {
  const zigApi = await loadZigApi();

  return zigApi.modules.map(apiModule => ({
    params: { module: apiModule.slug },
    props: {
      apiModule,
      lastmod: zigApi.lastmod,
    },
  }));
}

const { apiModule, lastmod } = Astro.props as Props;

const description = `${apiModule.summary} Generated reference page for ${apiModule.title} in the ZINC Zig API.`;
const keywords = `ZINC ${apiModule.title}, Zig API, ${apiModule.section}, ${apiModule.sourcePath}`;

const toc = apiModule.symbols.flatMap(symbol => [
  { label: symbol.qualifiedName, href: `#${symbol.anchor}`, depth: 0 },
  ...symbol.members.map(member => ({
    label: member.qualifiedName,
    href: `#${member.anchor}`,
    depth: 1,
  })),
]);

const kindOrder: ZigApiSymbol['symbolKind'][] = ['struct', 'function', 'enum', 'union', 'constant', 'variable'];
const kindLabels: Record<ZigApiSymbol['symbolKind'], string> = {
  struct: 'Structs',
  function: 'Functions',
  enum: 'Enums',
  union: 'Unions',
  constant: 'Constants',
  variable: 'Variables',
};
const symbolKindStats = kindOrder
  .map(kind => ({
    kind,
    label: kindLabels[kind],
    count: apiModule.symbols.filter(symbol => symbol.symbolKind === kind).length,
  }))
  .filter(item => item.count > 0);

function hasDocContent(symbol: ZigApiSymbol | ZigApiMember): boolean {
  return Boolean(
    symbol.doc.summary ||
      symbol.doc.description.length > 0 ||
      symbol.doc.params.length > 0 ||
      symbol.doc.returns ||
      symbol.doc.notes.length > 0
  );
}

function docSearchText(symbol: ZigApiSymbol | ZigApiMember): string {
  return [
    symbol.doc.summary,
    ...symbol.doc.description,
    ...symbol.doc.params.map(param => `${param.name} ${param.description}`),
    symbol.doc.returns ?? '',
    ...symbol.doc.notes,
  ].join(' ');
}

function memberSearchText(member: ZigApiMember): string {
  return [
    member.name,
    member.qualifiedName,
    member.signature,
    member.sourcePath,
    docSearchText(member),
  ].join(' ');
}

function symbolSearchText(symbol: ZigApiSymbol): string {
  const fields = symbol.fields?.map(field => `${field.name} ${field.type}`).join(' ') ?? '';
  return [
    symbol.name,
    symbol.qualifiedName,
    symbol.symbolKind,
    symbol.declarationKind,
    symbol.signature,
    symbol.sourcePath,
    fields,
    docSearchText(symbol),
  ].join(' ');
}
---

<DocLayout title={`${apiModule.title} Zig API`} description={description} keywords={keywords} lastmod={lastmod}>
  <div class="module-page" data-module-page>
    <div class="module-main">
      <section class="module-hero" data-module-hero>
        <div class="module-hero-top">
          <div>
            <p class="eyebrow">{apiModule.section}</p>
            <h1>{apiModule.title}</h1>
          </div>
          <a href="/zinc/docs/zig-api/" class="back-link">All API Sections</a>
        </div>

        <p class="module-summary">{apiModule.summary}</p>
        {apiModule.overview.map(paragraph => (
          <p class="module-overview">{paragraph}</p>
        ))}

        <div class="module-meta">
          <span>{apiModule.exportCount} exports</span>
          <span>{apiModule.memberCount} methods</span>
          <a href={getSourceHref(apiModule.sourcePath, apiModule.symbols[0]?.line ?? 1)} target="_blank" rel="noreferrer">
            {apiModule.sourcePath}
          </a>
        </div>

        <div class="module-tools" data-symbol-tools>
          <div class="symbol-filter-shell">
            <label class="sr-only" for="module-symbol-filter">Filter symbols in {apiModule.title}</label>
            <input
              id="module-symbol-filter"
              type="search"
              inputmode="search"
              autocomplete="off"
              spellcheck="false"
              placeholder={`Filter ${apiModule.title} exports and methods`}
              data-symbol-filter
            />
            <button type="button" class="symbol-filter-clear" data-symbol-filter-clear hidden aria-label="Clear symbol filter">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>

          <div class="kind-filters" aria-label="Filter by symbol kind">
            <button type="button" class="kind-filter active" data-symbol-kind-filter="all" aria-pressed="true">
              All <span>{apiModule.exportCount}</span>
            </button>
            {symbolKindStats.map(item => (
              <button type="button" class="kind-filter" data-symbol-kind-filter={item.kind} aria-pressed="false">
                {item.label} <span>{item.count}</span>
              </button>
            ))}
          </div>

          <p class="symbol-filter-status" data-symbol-filter-status>{apiModule.exportCount} exports shown</p>
        </div>
      </section>

      <div class="symbol-stack">
        {apiModule.symbols.map(symbol => (
          <section
            id={symbol.anchor}
            class="symbol-card"
            data-symbol-card
            data-symbol-kind={symbol.symbolKind}
            data-symbol-search={symbolSearchText(symbol)}
          >
            <div class="symbol-heading">
              <div>
                <p class="symbol-kind">{symbol.symbolKind}</p>
                <h2>{symbol.qualifiedName}</h2>
              </div>
              <a href={`#${symbol.anchor}`} class="anchor-link">#</a>
            </div>

            <pre tabindex="0" role="region" aria-label={`${symbol.qualifiedName} signature`}><code>{symbol.signature}</code></pre>

            {symbol.symbolKind === 'struct' && symbol.size !== undefined && (
              <div class="struct-layout meta-block">
                <h3>Memory Layout</h3>
                <p>Size: <strong>{symbol.size}</strong> bytes (alignment: {symbol.alignment})</p>
                {symbol.fields && symbol.fields.length > 0 && (
                  <div class="table-wrapper" tabindex="0" role="region" aria-label={`${symbol.qualifiedName} memory layout`}>
                    <table>
                      <thead>
                        <tr>
                          <th class="numeric">Offset</th>
                          <th class="numeric">Size</th>
                          <th class="numeric">Align</th>
                          <th>Field</th>
                          <th>Type</th>
                        </tr>
                      </thead>
                      <tbody>
                        {symbol.fields.map(field => (
                          <tr>
                            <td class="numeric">{field.offset}</td>
                            <td class="numeric">{field.size}</td>
                            <td class="numeric">{field.alignment}</td>
                            <td><code>{field.name}</code></td>
                            <td><code>{field.type}</code></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )}

            {hasDocContent(symbol) ? (
              <div class="doc-copy">
                {symbol.doc.summary && <p class="doc-summary">{symbol.doc.summary}</p>}
                {symbol.doc.description.map(paragraph => (
                  <p>{paragraph}</p>
                ))}

                {symbol.doc.params.length > 0 && (
                  <div class="meta-block">
                    <h3>Parameters</h3>
                    <dl class="detail-list">
                      {symbol.doc.params.map(param => (
                        <div>
                          <dt><code>{param.name}</code></dt>
                          <dd>{param.description}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                )}

                {symbol.doc.returns && (
                  <div class="meta-block">
                    <h3>Returns</h3>
                    <p>{symbol.doc.returns}</p>
                  </div>
                )}

                {symbol.doc.notes.length > 0 && (
                  <div class="meta-block">
                    <h3>Notes</h3>
                    {symbol.doc.notes.map(note => (
                      <p>{note}</p>
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <p class="doc-empty">No public doc comment yet.</p>
            )}

            <p class="source-meta">
              <a href={getSourceHref(symbol.sourcePath, symbol.line)} target="_blank" rel="noreferrer">
                {symbol.sourcePath}:{symbol.line}
              </a>
            </p>

            {symbol.members.length > 0 && (
              <div class="members">
                <div class="members-header">
                  <h3>Methods</h3>
                  <span>{symbol.members.length}</span>
                </div>

                <div class="member-stack">
                  {symbol.members.map(member => (
                    <article
                      id={member.anchor}
                      class="member-card"
                      data-member-card
                      data-member-search={memberSearchText(member)}
                    >
                      <div class="symbol-heading member-heading">
                        <div>
                          <p class="symbol-kind">method</p>
                          <h4>{member.qualifiedName}</h4>
                        </div>
                        <a href={`#${member.anchor}`} class="anchor-link">#</a>
                      </div>

                      <pre tabindex="0" role="region" aria-label={`${member.qualifiedName} signature`}><code>{member.signature}</code></pre>

                      {hasDocContent(member) ? (
                        <div class="doc-copy">
                          {member.doc.summary && <p class="doc-summary">{member.doc.summary}</p>}
                          {member.doc.description.map(paragraph => (
                            <p>{paragraph}</p>
                          ))}

                          {member.doc.params.length > 0 && (
                            <div class="meta-block">
                              <h5>Parameters</h5>
                              <dl class="detail-list">
                                {member.doc.params.map(param => (
                                  <div>
                                    <dt><code>{param.name}</code></dt>
                                    <dd>{param.description}</dd>
                                  </div>
                                ))}
                              </dl>
                            </div>
                          )}

                          {member.doc.returns && (
                            <div class="meta-block">
                              <h5>Returns</h5>
                              <p>{member.doc.returns}</p>
                            </div>
                          )}

                          {member.doc.notes.length > 0 && (
                            <div class="meta-block">
                              <h5>Notes</h5>
                              {member.doc.notes.map(note => (
                                <p>{note}</p>
                              ))}
                            </div>
                          )}
                        </div>
                      ) : (
                        <p class="doc-empty">No public doc comment yet.</p>
                      )}

                      <p class="source-meta">
                        <a href={getSourceHref(member.sourcePath, member.line)} target="_blank" rel="noreferrer">
                          {member.sourcePath}:{member.line}
                        </a>
                      </p>
                    </article>
                  ))}
                </div>
              </div>
            )}
          </section>
        ))}
      </div>
    </div>

    <aside class="toc" data-module-toc>
      <p class="eyebrow">On This Page</p>
      <ul>
        {toc.map(item => (
          <li class:list={[`depth-${item.depth}`]}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</DocLayout>

<script>
  const setupSymbolFilter = () => {
    const input = document.querySelector<HTMLInputElement>('[data-symbol-filter]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-symbol-filter-clear]');
    const status = document.querySelector<HTMLElement>('[data-symbol-filter-status]');
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-symbol-kind-filter]'));
    const symbolCards = Array.from(document.querySelectorAll<HTMLElement>('[data-symbol-card]'));
    if (!input || !clearButton || !status || symbolCards.length === 0) return;

    let activeKind = 'all';

    const normalize = (value: string) =>
      value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

    const matchesTerms = (value: string, terms: string[]) => {
      if (terms.length === 0) return true;
      const normalized = normalize(value);
      return terms.every(term => normalized.includes(term));
    };

    const setButtonState = () => {
      for (const button of filterButtons) {
        const selected = button.dataset.symbolKindFilter === activeKind;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      }
    };

    const applyFilter = () => {
      const rawQuery = input.value.trim();
      const terms = normalize(rawQuery).split(' ').filter(Boolean);
      clearButton.hidden = rawQuery.length === 0;

      let visibleCount = 0;

      for (const card of symbolCards) {
        const kind = card.dataset.symbolKind ?? '';
        const kindMatches = activeKind === 'all' || kind === activeKind;
        const symbolMatches = matchesTerms(card.dataset.symbolSearch ?? card.textContent ?? '', terms);
        const memberCards = Array.from(card.querySelectorAll<HTMLElement>('[data-member-card]'));
        let matchingMembers = 0;

        for (const member of memberCards) {
          const memberMatches = matchesTerms(member.dataset.memberSearch ?? member.textContent ?? '', terms);
          matchingMembers += memberMatches ? 1 : 0;
          member.hidden = rawQuery.length > 0 && !symbolMatches && !memberMatches;
        }

        const queryMatches = rawQuery.length === 0 || symbolMatches || matchingMembers > 0;
        const visible = kindMatches && queryMatches;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      setButtonState();
      status.textContent =
        visibleCount === 0
          ? 'No exports match the current filter.'
          : `${visibleCount} export${visibleCount === 1 ? '' : 's'} shown`;
    };

    input.addEventListener('input', applyFilter);
    clearButton.addEventListener('click', () => {
      input.value = '';
      input.focus();
      applyFilter();
    });

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        activeKind = button.dataset.symbolKindFilter ?? 'all';
        applyFilter();
      });
    }

    applyFilter();
  };

  const syncCondensedToc = () => {
    const toc = document.querySelector<HTMLElement>('[data-module-toc]');
    const hero = document.querySelector<HTMLElement>('[data-module-hero]');
    const page = document.querySelector<HTMLElement>('[data-module-page]');
    if (!toc || !hero || !page) return;

    const mobile = window.matchMedia('(max-width: 960px)');
    const update = () => {
      if (mobile.matches) {
        delete toc.dataset.condensed;
        delete page.dataset.tocCondensed;
        return;
      }

      const heroBottom = hero.getBoundingClientRect().bottom;
      const condensed = heroBottom <= 88;
      toc.dataset.condensed = condensed ? 'true' : 'false';
      page.dataset.tocCondensed = condensed ? 'true' : 'false';
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    mobile.addEventListener?.('change', update);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setupSymbolFilter();
      syncCondensedToc();
    }, { once: true });
  } else {
    setupSymbolFilter();
    syncCondensedToc();
  }
</script>

<style>
  .module-page {
    --toc-width: 180px;
    --toc-gap: var(--space-md);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--toc-width);
    gap: var(--toc-gap);
    align-items: start;
  }

  .module-page[data-toc-condensed="true"] {
    --toc-width: 136px;
    --toc-gap: 0.6rem;
  }

  .module-main {
    min-width: 0;
  }

  .module-hero {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--space-md);
    background: var(--color-bg);
    margin-bottom: var(--space-md);
  }

  .module-hero-top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .module-hero h1 {
    margin: 0 0 0.25rem;
    font-size: 1.55rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .back-link {
    white-space: nowrap;
    font-size: 0.76rem;
  }

  .module-summary {
    margin-bottom: 0.35rem;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .module-overview {
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .module-meta {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.65rem;
  }

  .module-meta span,
  .module-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0 0.45rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .module-tools {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto;
    gap: 0.45rem 0.75rem;
    align-items: center;
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
  }

  .symbol-filter-shell {
    position: relative;
    max-width: none;
  }

  .symbol-filter-shell input {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.48rem 2rem 0.48rem 0.65rem;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.82rem;
  }

  .symbol-filter-shell input:focus {
    outline: 2px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-color: var(--color-accent);
  }

  .symbol-filter-shell input::-webkit-search-cancel-button {
    display: none;
    -webkit-appearance: none;
  }

  .symbol-filter-shell input::-moz-search-clear-button {
    display: none;
  }

  .symbol-filter-clear {
    position: absolute;
    right: 0.55rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    border: 0;
    border-radius: 999px;
    padding: 0;
    background: color-mix(in srgb, var(--color-border) 72%, transparent);
    color: var(--color-text-muted);
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }

  .symbol-filter-clear:hover {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    color: var(--color-text);
  }

  .kind-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem;
  }

  .kind-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    min-height: 1.55rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0 0.45rem;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.68rem;
    cursor: pointer;
  }

  .kind-filter span {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .kind-filter:hover,
  .kind-filter.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg));
  }

  .kind-filter.active span {
    color: var(--color-accent);
  }

  .symbol-filter-status {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .symbol-stack,
  .member-stack {
    display: grid;
    gap: 0.55rem;
  }

  .symbol-card,
  .member-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.8rem;
    background: var(--color-bg);
    min-width: 0;
  }

  .member-card {
    background: var(--color-bg-alt);
  }

  .symbol-heading {
    display: flex;
    justify-content: space-between;
    gap: 0.45rem;
    align-items: flex-start;
    margin-bottom: 0.45rem;
  }

  .symbol-heading > div {
    min-width: 0;
  }

  .symbol-heading h2,
  .symbol-heading h4 {
    margin: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .symbol-heading h2 {
    font-size: 1.08rem;
  }

  .symbol-heading h4 {
    font-size: 0.92rem;
  }

  .symbol-kind {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.62rem;
    color: var(--color-text-muted);
    margin-bottom: 0.1rem;
  }

  .anchor-link {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .doc-summary {
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .symbol-card pre,
  .member-card pre {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
    margin-bottom: 0.55rem;
    padding: 0.55rem 0.65rem;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .symbol-card pre code,
  .member-card pre code {
    white-space: inherit;
  }

  /* Long signatures and layout tables need a visible keyboard scroll target. */
  .symbol-card pre:focus-visible,
  .member-card pre:focus-visible,
  .table-wrapper:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .doc-empty,
  .source-meta {
    color: var(--color-text-muted);
    font-size: 0.74rem;
    margin-bottom: 0;
  }

  .doc-copy p {
    margin-bottom: 0.45rem;
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .doc-copy,
  .doc-copy p,
  .doc-copy code {
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  :global(.module-page .code-shell) {
    max-width: 100%;
    margin-bottom: 0.55rem;
    border-radius: 8px;
    box-shadow: none;
    background: var(--color-bg-alt);
  }

  :global(.module-page .code-shell__header) {
    padding: 0.28rem 0.5rem;
    background: var(--color-bg-alt);
  }

  :global(.module-page .code-shell__label) {
    font-size: 0.58rem;
  }

  :global(.module-page .code-shell__copy) {
    padding: 0.12rem 0.42rem;
    border-radius: 6px;
    font-size: 0.62rem;
  }

  .module-meta a,
  .source-meta a,
  .detail-list dt code {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .members {
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-border);
  }

  .members-header {
    display: flex;
    justify-content: space-between;
    gap: 0.45rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .members-header h3 {
    margin: 0;
  }

  .members-header span {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .meta-block {
    margin-top: 0.65rem;
  }

  .meta-block h3,
  .meta-block h5 {
    margin-top: 0;
    margin-bottom: 0.25rem;
    font-size: 0.88rem;
  }

  .detail-list {
    display: grid;
    gap: 0.35rem;
  }

  .detail-list div {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.45rem 0.55rem;
    background: var(--color-bg);
  }

