---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import DocsSearch from '../../../components/DocsSearch.astro';
import { buildBreadcrumbList } from '../../../lib/structured-data';
import { loadDocs } from '../../../lib/docs-loader';
import { loadZigApi } from '../../../lib/zig-api-loader';

const docs = await loadDocs();
const zigApi = await loadZigApi();
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://zolotukhin.ai';
const breadcrumbItems = [{ name: 'Home', href: '/' }, { name: 'ZINC', href: '/zinc/' }, { name: 'Docs' }];
const starts = [
  { slug: 'getting-started', title: 'Run your first model', description: 'Install the prerequisites, build ZINC, and open a chat.' },
  { slug: 'running-zinc', title: 'Use the command line', description: 'Choose models, run prompts, and configure the server.' },
  { slug: 'api', title: 'Connect an app', description: 'Use the OpenAI-compatible API with curl or an SDK.' },
];
const setups = [
  { slug: 'binary-releases', title: 'Binary installation', description: 'Release status, runtime requirements, verified installation, and rollback.' },
  { slug: 'hardware-requirements', title: 'Hardware and memory', description: 'Supported GPUs, drivers, operating systems, and model sizing.' },
  { slug: 'rocm', title: 'AMD ROCm setup', description: 'Build and run the HIP backend on a validated Radeon stack.' },
  { slug: 'opencode', title: 'OpenCode setup', description: 'Connect a coding client to your local model.' },
  { slug: 'development', title: 'Build and contribute', description: 'Tests, debugging, benchmarking, and development tools.' },
];
const primarySlugs = new Set([...starts, ...setups].map(doc => doc.slug));
const references = docs.filter(doc => !primarySlugs.has(doc.slug));
const allLinks = [
  ...docs.map(doc => ({ label: doc.title, href: `/zinc/docs/${doc.slug}/` })),
  { label: 'Zig API reference', href: '/zinc/docs/zig-api/' },
];
---

<BaseLayout
  title="ZINC Documentation"
  description="Get ZINC running, choose a model, and connect your apps. Setup guides, CLI usage, API examples, and GPU engineering reference."
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'CollectionPage', name: 'ZINC Documentation', url: `${siteUrl}/zinc/docs/`,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: allLinks.map((doc, index) => ({
            '@type': 'ListItem', position: index + 1, name: doc.label, url: `${siteUrl}${doc.href}`,
          })),
        },
      },
      buildBreadcrumbList(siteUrl, breadcrumbItems),
    ],
  }}
>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="docs-hub">
    <header class="hub-header">
      <p class="eyebrow">ZINC documentation</p>
      <h1>From your first chat<br />to the GPU kernels.</h1>
      <p>Start with a model on your own machine. Find the setup, usage, and reference material as you need it.</p>
    </header>

    <DocsSearch />

    <section class="group" aria-labelledby="start-heading">
      <h2 id="start-heading">Start here</h2>
      <ol class="guide-list">
        {starts.map((doc, index) => (
          <li><a href={`/zinc/docs/${doc.slug}/`}>
            <span class="number" aria-hidden="true">0{index + 1}</span>
            <div><h3>{doc.title}</h3><p>{doc.description}</p></div>
            <span aria-hidden="true">→</span>
          </a></li>
        ))}
      </ol>
    </section>

    <section class="group" aria-labelledby="setup-heading">
      <h2 id="setup-heading">Setup and tools</h2>
      <div class="setup-list">
        {setups.map(doc => (
          <a href={`/zinc/docs/${doc.slug}/`}><h3>{doc.title} <span aria-hidden="true">→</span></h3><p>{doc.description}</p></a>
        ))}
      </div>
    </section>

    <section class="group reference" aria-labelledby="reference-heading">
      <h2 id="reference-heading">Engineering and reference</h2>
      <a class="api-link" href="/zinc/docs/zig-api/">
        <div><h3>Zig API reference <span aria-hidden="true">→</span></h3><p>Generated from the source: {zigApi.moduleCount} modules and {zigApi.exportCount} exports.</p></div>
      </a>
      <details>
        <summary>Browse {references.length} engineering guides and reports</summary>
        <ul class="reference-list">
          {references.map(doc => <li><a href={`/zinc/docs/${doc.slug}/`}>{doc.title}</a></li>)}
        </ul>
      </details>
      <p class="reference-note">Search covers all guides and source symbols, including the reference material above.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .docs-hub { max-width: 54rem; margin: 0 auto; }
  .hub-header { max-width: 39rem; margin: 1.5rem 0 2rem; }
  .eyebrow { margin: 0 0 0.8rem; color: var(--color-text-muted); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .hub-header h1 { margin: 0 0 1rem; font-size: clamp(2.2rem, 4.8vw, 3.2rem); line-height: 1.12; letter-spacing: -0.04em; }
  .hub-header > p:last-child { color: var(--color-text-muted); font-size: 0.95rem; }
  .group { margin-top: 3rem; }
  .group h2 { margin: 0 0 1.25rem; font-size: 1.15rem; }
  .guide-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-border); }
  .guide-list li { margin: 0; }
  .guide-list a { display: grid; grid-template-columns: 1.5rem 1fr 1rem; align-items: baseline; gap: 1.2rem; padding: 1.35rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-text); }
  .guide-list a:hover, .setup-list a:hover, .api-link:hover { text-decoration: none; }
  .guide-list a:hover h3, .setup-list a:hover h3, .api-link:hover h3 { color: var(--color-accent); }
  .number { color: var(--color-text-muted); font: 0.68rem var(--font-mono); }
  h3 { margin: 0; font-size: 0.98rem; }
  .guide-list p, .setup-list p, .api-link p { margin: 0.35rem 0 0; color: var(--color-text-muted); font-size: 0.8rem; line-height: 1.55; }
  .setup-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2.5rem; }
  .setup-list a { padding: 1.15rem 0; border-top: 1px solid var(--color-border); color: var(--color-text); }
  .setup-list h3 span { color: var(--color-text-muted); font-weight: 400; }
  .api-link { display: block; color: var(--color-text); padding: 1.25rem 0; border-top: 1px solid var(--color-border); }
  details { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  summary { padding: 1rem 0; font-size: 0.85rem; cursor: pointer; }
  .reference-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 2rem; list-style: none; padding: 0 0 1.25rem; margin: 0; }
  .reference-list li { margin: 0; }
  .reference-list a { display: inline-block; font-size: 0.78rem; }
  .reference-note { margin: 1rem 0 0; font-size: 0.73rem; color: var(--color-text-muted); }
  @media (max-width: 600px) {
    .setup-list, .reference-list { grid-template-columns: 1fr; }
    .guide-list a { gap: 0.7rem; }
  }
</style>
