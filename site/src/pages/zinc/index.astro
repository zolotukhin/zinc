---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import { buildBreadcrumbList } from '../../lib/structured-data';
import benchmarkData from '../../data/zinc-performance.json';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://zolotukhin.ai';
const breadcrumbItems = [{ name: 'Home', href: '/' }, { name: 'ZINC' }];
const target = benchmarkData.targets.find((target: any) => target.id === 'rdna-rocm');
const median = (metric: any) => metric?.median ?? metric?.avg ?? null;
const rate = (value: number | null) => value == null ? '—' : value.toFixed(2);
const examples = [
  { id: 'qwen35-9b-q4k-m', label: 'Qwen 3.5 9B' },
  { id: 'qwen38-27b-q4k-m', label: 'Qwen 3.8 27B' },
  { id: 'gemma4-31b-q4k-m', label: 'Gemma 4 31B' },
].map(({ id, label }) => {
  const model = target?.models?.find((model: any) => model.id === id);
  const scenario = model?.scenarios?.find((scenario: any) => scenario.id === 'core');
  // Keep this cross-engine comparison non-speculative on both sides.
  const zinc = scenario?.variants?.mtp_off?.zinc ?? scenario?.zinc;
  return { label, zinc: median(zinc?.decode_tps), baseline: median(scenario?.baseline?.decode_tps) };
});
const platforms = [
  { name: 'AMD Radeon', backend: 'Vulkan or ROCm', note: 'Linux · RDNA3 / RDNA4', href: '/zinc/docs/rocm/', link: 'AMD setup' },
  { name: 'Apple Silicon', backend: 'Metal', note: 'macOS · M-series', href: '/zinc/docs/getting-started/#macos-apple-silicon', link: 'Mac setup' },
  { name: 'Intel Arc', backend: 'Vulkan', note: 'Linux · Xe2 / Battlemage', href: '/zinc/docs/intel-gpu-reference/', link: 'Intel setup' },
  { name: 'NVIDIA RTX', backend: 'CUDA · experimental', note: 'Linux / WSL2', href: '/zinc/docs/hardware-requirements/', link: 'Requirements' },
];
const description = 'Run GGUF language models on your own GPU with ZINC. Start with browser chat, use the command line, or connect an app through the OpenAI-compatible API.';
---

<BaseLayout
  title="ZINC — Run local AI on your GPU"
  description={description}
  keywords="ZINC, local AI, GGUF, GPU inference, Zig, AMD Radeon, ROCm, Vulkan, Apple Silicon, Metal, Intel Arc, OpenAI-compatible API"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'SoftwareApplication', name: 'ZINC', description,
        url: `${siteUrl}/zinc/`, applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Linux, macOS',
        codeRepository: 'https://github.com/zolotukhin/zinc',
        license: 'https://github.com/zolotukhin/zinc/blob/main/LICENSE',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      },
      buildBreadcrumbList(siteUrl, breadcrumbItems),
    ],
  }}
>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="hero">
    <div>
      <p class="wordmark"><img src="/zinc-logo.png" alt="" width="40" height="40" /> ZINC</p>
      <h1>Run local AI<br />on your GPU.</h1>
      <p class="intro">Load a GGUF model, chat in your browser, or connect an app through the OpenAI-compatible API.</p>
      <div class="actions">
        <a href="/zinc/docs/getting-started/" class="button primary">Get started <span aria-hidden="true">→</span></a>
        <a href="https://github.com/zolotukhin/zinc" class="button">View on GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <p class="build-note">One native binary · Zig 0.17 · MIT licensed</p>
    </div>
    <div class="use-cases" aria-label="Ways to use ZINC">
      <a href="/zinc/docs/getting-started/#start-the-chat-ui">
        <span class="number" aria-hidden="true">01</span>
        <div><h2>Chat in your browser</h2><p>A built-in interface for local conversations.</p></div>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/zinc/docs/running-zinc/">
        <span class="number" aria-hidden="true">02</span>
        <div><h2>Use the terminal</h2><p>Run a prompt or work with your own GGUF files.</p></div>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/zinc/docs/api/">
        <span class="number" aria-hidden="true">03</span>
        <div><h2>Connect your apps</h2><p>Use an OpenAI-compatible local API.</p></div>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="page-section quickstart" aria-labelledby="start-heading">
    <div class="section-copy">
      <p class="eyebrow">Get running</p>
      <h2 id="start-heading">Start with one model.</h2>
      <p>Follow the <a href="/zinc/docs/getting-started/">setup guide</a> to install the prerequisites for your GPU, then build and open a chat.</p>
      <p>The build selects Vulkan on Linux and Metal on macOS. The wrapper downloads and verifies Zig 0.17.0 when needed.</p>
      <p>Prefer a download? The first binary release is undergoing qualification. See <a href="/zinc/docs/binary-releases/">release status and installation</a>.</p>
      <p class="setup-note">AMD with Vulkan: set <code>RADV_PERFTEST=coop_matrix</code> before the GPU check or chat. ROCm has its own <a href="/zinc/docs/rocm/">build instructions</a>.</p>
    </div>
    <div class="terminal-wrap">
      <TerminalWindow title="Build and chat" density="compact" code={`git clone https://github.com/zolotukhin/zinc.git
cd zinc
./scripts/zig.sh build -Doptimize=ReleaseFast

./zig-out/bin/zinc --check
./zig-out/bin/zinc model pull qwen35-9b-q4k-m
./zig-out/bin/zinc chat --model-id qwen35-9b-q4k-m`} />
      <p class="caption">The example downloads Qwen 3.5 9B. Check <a href="/zinc/docs/hardware-requirements/">memory requirements</a> or use <code>zinc model list</code> to browse the catalog.</p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="hardware-heading">
    <div class="section-copy">
      <p class="eyebrow">Use your hardware</p>
      <h2 id="hardware-heading">Choose your GPU path.</h2>
      <p>AMD, Apple Silicon and Intel Arc are supported. NVIDIA CUDA is experimental. Model coverage varies by backend.</p>
      <a class="text-link" href="/zinc/docs/hardware-requirements/">Check hardware and memory requirements →</a>
    </div>
    <div class="platforms">
      {platforms.map(platform => (
        <a href={platform.href} class="platform">
          <div><h3>{platform.name}</h3><p>{platform.note}</p></div>
          <div class="platform-detail"><span>{platform.backend}</span><small>{platform.link} <span aria-hidden="true">↗</span></small></div>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section quickstart" aria-labelledby="harness-heading">
    <div class="section-copy">
      <p class="eyebrow">Coding harnesses</p>
      <h2 id="harness-heading">Use OpenCode with your model.</h2>
      <p>Connect a running ZINC server, check streaming tool calls, and run coding tasks with project tests between editing rounds.</p>
      <p>The setup script creates a portable project config. Your endpoints and keys stay in runtime environment variables.</p>
      <p><a class="text-link" href="/zinc/docs/opencode/">OpenCode setup and testing guide →</a></p>
      <a class="text-link" href="/zinc/harnesses/setup-opencode.mjs" download="setup-opencode.mjs">Download the setup script ↓</a>
    </div>
    <div class="terminal-wrap">
      <TerminalWindow title="Connect OpenCode" density="compact" code={`bun install --global opencode-ai@1.19.4
bun tools/setup_opencode.mjs --project ../my-project --context 32768
bun tools/setup_opencode.mjs check --project ../my-project
bun tools/setup_opencode.mjs run --project ../my-project \\
  --auto --verify 'bun test' -- "Fix the failing tests and run them."`} />
      <p class="caption">Run from the ZINC checkout with a Qwen server at <code>-c 32768 --parallel 1</code>. Match your server's context and replace <code>bun test</code> with your project's acceptance command.</p>
    </div>
  </section>

  <section class="page-section" aria-labelledby="performance-heading">
    <div class="section-copy">
      <p class="eyebrow">Measured in the open</p>
      <h2 id="performance-heading">See how it performs.</h2>
      <p>Compare ZINC with llama.cpp on the same GPU, GGUF file and prompts, using reusable servers and repeated runs.</p>
      <a class="text-link" href="/zinc/benchmarks/">Explore all models and GPUs →</a>
    </div>
    <div class="results">
      <table>
        <caption>Answer generation · tokens per second</caption>
        <thead><tr><th scope="col">Model</th><th scope="col">ZINC</th><th scope="col">llama.cpp</th></tr></thead>
        <tbody>{examples.map(row => (
          <tr><th scope="row">{row.label}</th><td><strong>{rate(row.zinc)}</strong></td><td>{rate(row.baseline)}</td></tr>
        ))}</tbody>
      </table>
      <p class="caption">Radeon AI PRO R9700 · ROCm · Q4_K_M · Quick Chat median · {target?.generated_at?.slice(0, 10)}. Speculative decoding is off for both engines. <a href="/zinc/benchmarks/#rdna-rocm">Method and samples →</a></p>
      <p class="engineering-note">Latest engineering note: <a href="/zinc/docs/rocm-mtp-0-17/">faster Qwen 3.8 27B speculative decoding on Zig 0.17 →</a></p>
    </div>
  </section>

  <section class="next-steps" aria-labelledby="next-heading">
    <h2 id="next-heading">Go a little further.</h2>
    <nav aria-label="More ZINC resources">
      <a href="/zinc/docs/">Browse documentation <span aria-hidden="true">→</span></a>
      <a href="/zinc/docs/api/">Connect an API client <span aria-hidden="true">→</span></a>
      <a href="/zinc/docs/opencode/">Set up a coding harness <span aria-hidden="true">→</span></a>
      <a href="/zinc/docs/development/">Build and contribute <span aria-hidden="true">→</span></a>
      <a href="https://discord.gg/QRUgWH2aGV">Join the community <span aria-hidden="true">↗</span></a>
    </nav>
  </section>
</BaseLayout>

<style>
  :global(main.container) { max-width: var(--max-width-wide); }
  .hero { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 5rem; padding: 2rem 0 4.5rem; }
  .wordmark { display: flex; align-items: center; gap: 0.65rem; margin: 0 0 1.4rem; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.1em; }
  .wordmark img { border-radius: 8px; }
  h1 { margin: 0 0 1.4rem; font-size: clamp(2.7rem, 5.5vw, 4.25rem); line-height: 1.06; letter-spacing: -0.045em; font-weight: 600; }
  .intro { max-width: 32rem; color: var(--color-text-muted); font-size: 1.08rem; line-height: 1.65; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 46px; padding: 0.6rem 1rem; border: 1px solid var(--color-border); border-radius: 6px; color: var(--color-text); font-size: 0.82rem; font-weight: 600; }
  .button.primary { color: white; background: #b34700; border-color: #b34700; }
  .button:hover { border-color: var(--color-accent); text-decoration: none; }
  .button.primary:hover { background: #943c00; border-color: #943c00; }
  .build-note { margin: 1rem 0 0; color: var(--color-text-muted); font-size: 0.72rem; }
  .use-cases { border-top: 1px solid var(--color-border); }
  .use-cases a { display: grid; grid-template-columns: 1.4rem 1fr 1rem; align-items: baseline; gap: 1rem; padding: 1.65rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-text); }
  .use-cases a:hover { text-decoration: none; }
  .use-cases a:hover h2 { color: var(--color-accent); }
  .use-cases h2 { margin: 0 0 0.35rem; font-size: 1.04rem; }
  .use-cases p { margin: 0; color: var(--color-text-muted); font-size: 0.82rem; line-height: 1.55; }
  .number { color: var(--color-text-muted); font: 0.66rem var(--font-mono); }
  .page-section { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); gap: 5rem; padding: 3.5rem 0; border-top: 1px solid var(--color-border); }
  .eyebrow { margin: 0 0 0.65rem; color: var(--color-text-muted); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .section-copy h2 { margin: 0 0 1rem; font-size: 1.7rem; line-height: 1.25; letter-spacing: -0.025em; }
  .section-copy > p:not(.eyebrow) { color: var(--color-text-muted); font-size: 0.88rem; }
  .section-copy .setup-note { font-size: 0.76rem; }
  .terminal-wrap { min-width: 0; }
  .terminal-wrap :global(.terminal-window) { --terminal-shadow: none; --terminal-radius: 8px; }
  .caption { margin: 0.8rem 0 0; color: var(--color-text-muted); font-size: 0.71rem; line-height: 1.6; }
  .text-link { display: inline-block; font-size: 0.82rem; }
  .platforms { border-top: 1px solid var(--color-border); }
  .platform { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-text); }
  .platform:hover { text-decoration: none; }
  .platform:hover h3 { color: var(--color-accent); }
  .platform h3 { margin: 0; font-size: 0.95rem; }
  .platform p { margin: 0.25rem 0 0; color: var(--color-text-muted); font-size: 0.72rem; }
  .platform-detail { display: grid; gap: 0.25rem; text-align: right; font-size: 0.76rem; }
  .platform-detail small { color: var(--color-text-muted); font-size: 0.68rem; }
  .results { min-width: 0; }
  table { margin: 0; font-size: 0.83rem; }
  caption { margin-bottom: 1rem; text-align: left; font-size: 0.8rem; color: var(--color-text-muted); }
  th, td { padding: 0.85rem 0.7rem; border: 0; border-bottom: 1px solid var(--color-border); }
  th:first-child { padding-left: 0; }
  th { background: none; font-weight: 500; }
  thead th { padding-top: 0; color: var(--color-text-muted); font-size: 0.68rem; }
  td, th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
  td strong { color: var(--color-accent); font-weight: 600; }
  .engineering-note { margin: 1.4rem 0 0; font-size: 0.75rem; }
  .next-steps { padding: 3rem 0 1rem; border-top: 1px solid var(--color-border); }
  .next-steps h2 { margin: 0 0 1.4rem; font-size: 1.25rem; }
  .next-steps nav { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem; }
  .next-steps a { font-size: 0.82rem; }
  @media (max-width: 960px) { .hero, .page-section { gap: 2.5rem; } }
  @media (max-width: 760px) {
    .hero, .page-section { grid-template-columns: 1fr; }
    .hero { padding: 1.5rem 0 3rem; }
    .hero h1 { max-width: 30rem; }
    .use-cases a { padding: 1.2rem 0; }
    .page-section { padding: 2.5rem 0; gap: 1.5rem; }
    .section-copy { max-width: 35rem; }
    .next-steps nav { display: grid; grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 380px) {
    h1 { font-size: 2.4rem; }
    .button { width: 100%; justify-content: space-between; }
    .platform { align-items: start; }
    .platform-detail { max-width: 8rem; }
    table { font-size: 0.73rem; }
    th, td { padding: 0.75rem 0.35rem; }
    .next-steps nav { grid-template-columns: 1fr; }
  }
</style>
