---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import { buildBreadcrumbList } from '../../lib/structured-data';
import benchmarkData from '../../data/zinc-performance.json';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://zolotukhin.ai';
const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'ZINC' },
];
const discordUrl = 'https://discord.gg/QRUgWH2aGV';

function metricMedian(summary: any) {
  return summary?.median ?? summary?.avg ?? null;
}

function formatTokNumber(value: number | null | undefined, digits = 2) {
  if (value == null || Number.isNaN(value)) return 'n/a';
  return value.toFixed(digits);
}

function formatTok(value: number | null | undefined, digits = 2) {
  const formatted = formatTokNumber(value, digits);
  return formatted === 'n/a' ? formatted : `${formatted} tok/s`;
}

function formatMultiplier(zinc: number | null | undefined, baseline: number | null | undefined) {
  if (zinc == null || baseline == null || Number.isNaN(zinc) || Number.isNaN(baseline) || baseline <= 0) return 'n/a';
  return `${(zinc / baseline).toFixed(2)}x`;
}

function formatPercent(value: number | null | undefined) {
  if (value == null || Number.isNaN(value)) return 'n/a';
  return `${Math.round(value)}%`;
}

function formatRefreshDate(iso: string | null | undefined) {
  return iso?.slice(0, 10) ?? 'latest';
}

function targetById(id: string) {
  return benchmarkData.targets.find((target: any) => target.id === id) ?? null;
}

function modelById(target: any, id: string) {
  return target?.models?.find((model: any) => model.id === id) ?? null;
}

function displayModelLabel(label: string) {
  return label
    .replace(/\bQ4_K_XL\b/g, 'Q4K XL')
    .replace(/\bQ4_K_M\b/g, 'Q4K M');
}

const rdnaTarget = targetById('rdna');
const rdnaRocmTarget = targetById('rdna-rocm');
const cudaTarget = targetById('cuda');
const intelTarget = targetById('intel');
const metalTarget = targetById('metal');
const rdna35 = modelById(rdnaTarget, 'qwen36-35b-a3b-q4k-xl');
const rdnaRocm38 = modelById(rdnaRocmTarget, 'qwen38-27b-q4k-m');
const metal35 = modelById(metalTarget, 'qwen36-35b-a3b-q4k-xl');

const rdna35Decode = metricMedian(rdna35?.zinc?.decode_tps);
const rdna35BaselineDecode = metricMedian(rdna35?.baseline?.decode_tps);
const rdnaRocm38Decode = metricMedian(rdnaRocm38?.zinc?.decode_tps);
const rdnaRocm38BaselineDecode = metricMedian(rdnaRocm38?.baseline?.decode_tps);
const metal35Decode = metricMedian(metal35?.zinc?.decode_tps);

const homeDescription = `Run GGUF models locally with ZINC. Use Vulkan or ROCm on AMD Radeon, Vulkan on Intel Arc, Metal on Apple Silicon, or the experimental CUDA backend on NVIDIA RTX.`;
const appDescription = `A Zig inference engine for running GGUF models on consumer GPUs, with Vulkan, ROCm, Metal, and experimental CUDA backends.`;
const performanceAnswer = `On the Radeon AI PRO R9700 (32GB, 640 GB/s), ZINC publishes independent Vulkan and ROCm server comparisons against llama.cpp. Vulkan reaches ${formatTokNumber(rdna35Decode)} tok/s on Qwen3.6-35B-A3B (${formatMultiplier(rdna35Decode, rdna35BaselineDecode)} llama.cpp), while ROCm reaches ${formatTokNumber(rdnaRocm38Decode)} tok/s on Qwen3.8-27B (${formatMultiplier(rdnaRocm38Decode, rdnaRocm38BaselineDecode)} llama.cpp). On the current Apple Silicon validation box, a Mac Studio (Mac16,9) with Apple M4 Max, 40-core GPU, and 64 GB unified memory, Qwen3.6-35B-A3B measures ${formatTokNumber(metal35Decode)} tok/s decode in the Metal benchmark.`;

function ratioX(zinc: number | null | undefined, baseline: number | null | undefined) {
  if (zinc == null || baseline == null || Number.isNaN(zinc) || Number.isNaN(baseline) || baseline <= 0) return null;
  return zinc / baseline;
}

function formatRatioX(zinc: number | null | undefined, baseline: number | null | undefined) {
  const r = ratioX(zinc, baseline);
  return r == null ? 'n/a' : `${r.toFixed(2)}x`;
}

function ratioTone(zinc: number | null | undefined, baseline: number | null | undefined) {
  const r = ratioX(zinc, baseline);
  if (r == null) return 'neutral';
  if (r >= 1) return 'win';
  if (r >= 0.8) return 'close';
  return 'behind';
}

function barPct(value: number | null | undefined, max: number | null | undefined) {
  if (value == null || Number.isNaN(value) || max == null || max <= 0) return 0;
  return Math.max(3, Math.min(100, (value / max) * 100));
}

function buildBoard(target: any, ids: string[]) {
  const rows = ids
    .map((id) => modelById(target, id))
    .filter(Boolean)
    .map((model: any) => ({
      label: displayModelLabel(model.label ?? model.id),
      zincDecode: metricMedian(model.zinc?.decode_tps),
      baselineDecode: metricMedian(model.baseline?.decode_tps),
      zincPrefill: metricMedian(model.zinc?.prefill_tps),
      baselinePrefill: metricMedian(model.baseline?.prefill_tps),
      overallPct: model.comparison?.overall_pct_of_baseline ?? null,
      endToEndPct: model.comparison?.end_to_end_pct_of_baseline ?? null,
    }));
  const decodeMax = Math.max(0, ...rows.flatMap((r) => [r.zincDecode, r.baselineDecode]).filter((v): v is number => v != null && !Number.isNaN(v)));
  const prefillMax = Math.max(0, ...rows.flatMap((r) => [r.zincPrefill, r.baselinePrefill]).filter((v): v is number => v != null && !Number.isNaN(v)));
  return { rows, decodeMax, prefillMax };
}

const rdnaBoard = buildBoard(rdnaTarget, [
  'qwen36-35b-a3b-q4k-xl',
  'qwen35-9b-q4k-m',
  'qwen38-27b-q4k-m',
  'gemma4-26b-a4b-q4k-m',
  'gemma4-31b-q4k-m',
]);

const metalBoard = buildBoard(metalTarget, [
  'qwen36-35b-a3b-q4k-xl',
  'qwen3-8b-q4k-m',
  'gemma4-26b-a4b-q4k-m',
  'gemma4-31b-q4k-m',
]);

const rdnaModelCount = rdnaBoard.rows.length;
const rdnaDecodeWins = rdnaBoard.rows.filter((row) => (ratioX(row.zincDecode, row.baselineDecode) ?? 0) >= 1).length;
const rdnaPrefillWins = rdnaBoard.rows.filter((row) => (ratioX(row.zincPrefill, row.baselinePrefill) ?? 0) >= 1).length;
const rdnaOverallWins = rdnaBoard.rows.filter((row) => (row.overallPct ?? 0) >= 100).length;
const rdnaRocmModelCount = rdnaRocmTarget?.summary?.benchmarked_models ?? rdnaRocmTarget?.models?.length ?? 0;
const rdnaRocmSuccessfulCount = rdnaRocmTarget?.summary?.successful_models ?? 0;

const platformCards = [
  {
    title: 'AMD Radeon',
    backend: 'Vulkan',
    status: 'Supported',
    metric: `${rdnaDecodeWins}/${rdnaModelCount} decode wins`,
    note: 'Five RDNA4 models measured against llama.cpp.',
  },
  {
    title: 'AMD Radeon',
    backend: 'ROCm',
    status: 'Supported',
    metric: `${rdnaRocmSuccessfulCount}/${rdnaRocmModelCount} models complete`,
    note: 'All five benchmark models complete on gfx1201; Gemma is the next tuning focus.',
  },
  {
    title: 'Apple Silicon',
    backend: 'Metal',
    status: 'Supported',
    metric: `${formatTokNumber(metalTarget?.summary?.fastest_decode_tps, 1)} tok/s top decode`,
    note: 'Native MSL kernels and zero-copy unified-memory loading.',
  },
  {
    title: 'NVIDIA RTX',
    backend: 'CUDA',
    status: 'Experimental',
    metric: `${formatTokNumber(cudaTarget?.summary?.fastest_decode_tps, 1)} tok/s top decode`,
    note: 'RTX 5090/4090 CUDA path is measured and still maturing.',
  },
  {
    title: 'Intel Arc',
    backend: 'Vulkan',
    status: 'Supported',
    metric: `${formatTokNumber(intelTarget?.summary?.fastest_decode_tps, 1)} tok/s top decode`,
    note: 'Official Linux Vulkan target with four model rows published.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'ZINC',
      description: appDescription,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS',
      url: `${siteUrl}/zinc`,
      codeRepository: 'https://github.com/zolotukhin/zinc',
      author: {
        '@type': 'Person',
        name: 'Stepan Zolotukhin',
        url: `${siteUrl}/about`,
      },
      keywords: 'consumer GPU LLM inference, local LLM inference engine, AMD GPU LLM inference, Apple Silicon LLM inference, NVIDIA CUDA LLM inference, Intel Arc LLM inference, Radeon LLM inference, RDNA4 inference, Vulkan compute, ROCm HIP inference, Metal inference, CUDA backend, Zig, TurboQuant, KV cache compression, OpenAI API, local AI, vLLM alternative, llama.cpp alternative',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Which consumer GPUs does ZINC target?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'ZINC runs local models on AMD Radeon through Vulkan or ROCm, Intel Arc through Vulkan, Apple Silicon through Metal, and NVIDIA RTX through an experimental CUDA backend.',
          },
        },
        {
          '@type': 'Question',
          name: 'Should I use Vulkan or ROCm on AMD Radeon?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'ZINC supports AMD Radeon through both Vulkan and ROCm. Use the default Vulkan build for broad RDNA3/RDNA4 compatibility, or select the ROCm build for the HIP runtime and its dedicated gfx1201 kernels. The public dashboard publishes the two backends independently on the same Radeon AI PRO R9700.',
          },
        },
        {
          '@type': 'Question',
          name: 'Which GPUs are fastest for local LLM inference with ZINC?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: `The Radeon AI PRO R9700 (32 GB, 640 GB/s) is the primary RDNA4 tuning target. The dashboard publishes both Vulkan and ROCm runs on that card, alongside Intel Arc Vulkan results, Apple Silicon Metal results, and NVIDIA RTX CUDA experiments.`,
          },
        },
        {
          '@type': 'Question',
          name: 'How does ZINC compare to llama.cpp and vLLM?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'llama.cpp is the broad local baseline and vLLM is commonly used for larger CUDA and ROCm servers. ZINC focuses on consumer GPUs, with dedicated Vulkan, ROCm, Metal, and experimental CUDA code plus an OpenAI-compatible API and built-in chat UI.',
          },
        },
        {
          '@type': 'Question',
          name: 'What performance does ZINC achieve on RDNA4 and Apple Silicon?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: performanceAnswer,
          },
        },
        {
          '@type': 'Question',
          name: 'What is TurboQuant and how does it help?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'TurboQuant is ZINC\'s KV-compression direction and public implementation spec for 2-4 bit cache compression. It is part of the roadmap and not the reason for the current benchmark numbers on the public site.',
          },
        },
      ],
    },
    buildBreadcrumbList(siteUrl, breadcrumbItems),
  ],
};
---

<BaseLayout
  title="ZINC — Local LLM Inference for Consumer GPUs"
  description={homeDescription}
  keywords="ZINC, consumer GPU LLM inference, local LLM inference engine, AMD GPU LLM inference, Apple Silicon Metal inference, NVIDIA CUDA LLM inference, Intel Arc LLM inference, Radeon LLM inference, RDNA4 inference, RDNA3 inference, ROCm HIP inference, RX 9070 XT, RTX 5090, Intel Arc, Vulkan compute, Metal, CUDA, Zig, TurboQuant, KV cache compression, vLLM alternative, llama.cpp alternative, OpenAI compatible API, local AI, GGUF, Qwen, Gemma"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={breadcrumbItems} />
  <section class="hero">
    <img src="/zinc-logo.png" alt="ZINC inference engine logo — lightning bolt on circuit board" class="logo" width="120" height="120" />
    <p class="hero-eyebrow">Local LLM inference</p>
    <h1>Run local models on your own GPU</h1>
    <p class="tagline">ZINC is a Zig program for running GGUF models. It includes a command-line tool, a browser chat UI, and an OpenAI-compatible API.</p>
    <p class="hero-platforms">Use <strong>Vulkan or ROCm</strong> on AMD Radeon, <strong>Vulkan</strong> on Intel Arc, or <strong>Metal</strong> on Apple Silicon. The NVIDIA CUDA backend is experimental.</p>
    <div class="hero-links">
      <a href="https://github.com/zolotukhin/zinc" class="hero-link">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        View on GitHub
      </a>
      <a href="/zinc/benchmarks/" class="hero-link hero-link-benchmarks">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19h16"/><path d="M7 16V9"/><path d="M12 16V5"/><path d="M17 16v-4"/></svg>
        Benchmarks
      </a>
      <a href={discordUrl} class="hero-link hero-link-discord">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369A19.791 19.791 0 0015.558 3c-.206.375-.446.872-.61 1.264a18.27 18.27 0 00-5.896 0A12.64 12.64 0 008.44 3a19.736 19.736 0 00-4.76 1.369C.533 9.091-.32 13.699.099 18.243a19.9 19.9 0 005.993 3.03c.486-.665.918-1.368 1.288-2.109-.709-.268-1.388-.602-2.028-.99.17-.124.336-.252.496-.385 3.915 1.84 8.163 1.84 12.032 0 .162.133.328.261.496.385-.642.39-1.323.724-2.033.992.37.739.8 1.442 1.288 2.107a19.861 19.861 0 005.995-3.03c.492-5.265-.84-9.831-3.31-13.874zM8.02 15.331c-1.182 0-2.157-1.085-2.157-2.419 0-1.334.956-2.419 2.157-2.419 1.209 0 2.176 1.094 2.157 2.419 0 1.334-.956 2.419-2.157 2.419zm7.96 0c-1.182 0-2.157-1.085-2.157-2.419 0-1.334.956-2.419 2.157-2.419 1.209 0 2.176 1.094 2.157 2.419 0 1.334-.948 2.419-2.157 2.419z"/></svg>
        Join ZINC Discord
      </a>
    </div>
  </section>

  <section class="platform-strip" aria-label="Consumer GPU backend status">
    {platformCards.map((card) => (
      <article class="platform-card">
        <div class="platform-card-head">
          <strong>{card.title}</strong>
          <span>{card.backend}</span>
        </div>
        <p class="platform-status">{card.status}</p>
        <p class="platform-metric">{card.metric}</p>
        <small>{card.note}</small>
      </article>
    ))}
  </section>

  <section class="amd-sweep" aria-labelledby="amd-sweep-heading">
    <div class="sweep-header">
      <div>
        <p class="section-kicker">Vulkan results</p>
        <h2 id="amd-sweep-heading">AMD RDNA4 — Radeon AI PRO R9700</h2>
      </div>
      <span class="sweep-machine">Vulkan · 32 GB VRAM · 640 GB/s · {formatRefreshDate(rdnaTarget?.generated_at)}</span>
    </div>

    <div class="perf-stats">
      <article class="perf-stat highlight">
        <strong>{rdnaDecodeWins}/{rdnaModelCount}</strong>
        <span>decode wins</span>
        <small>ZINC vs llama.cpp</small>
      </article>
      <article class="perf-stat">
        <strong>{rdnaPrefillWins}/{rdnaModelCount}</strong>
        <span>prefill wins</span>
        <small>same prompts and model files</small>
      </article>
      <article class="perf-stat">
        <strong>{rdnaOverallWins}/{rdnaModelCount}</strong>
        <span>overall wins</span>
        <small>combined prefill and decode</small>
      </article>
      <article class="perf-stat">
        <strong>{formatTokNumber(rdna35Decode, 1)}</strong>
        <span>tok/s top decode</span>
        <small>Qwen3.6 35B A3B</small>
      </article>
    </div>

    <div class="perf-board rdna-showcase" role="img" aria-label="ZINC vs llama.cpp throughput on AMD RDNA4">
      <div class="perf-board-legend">
        <span><i class="perf-swatch zinc"></i>ZINC</span>
        <span><i class="perf-swatch baseline"></i>llama.cpp</span>
        <span class="perf-board-note">decode tok/s · higher is better</span>
      </div>
      {rdnaBoard.rows.map((row) => (
        <article class="perf-bench-row">
          <div class="perf-bench-head">
            <strong>{row.label}</strong>
            <span class:list={['perf-ratio', ratioTone(row.zincDecode, row.baselineDecode)]}>{formatRatioX(row.zincDecode, row.baselineDecode)} llama.cpp</span>
          </div>
          <div class="perf-bar">
            <span class="perf-bar-tag">ZINC</span>
            <div class="perf-track"><i class="perf-fill zinc" style={`width:${barPct(row.zincDecode, rdnaBoard.decodeMax)}%`}></i></div>
            <span class="perf-bar-val">{formatTok(row.zincDecode, 1)}</span>
          </div>
          <div class="perf-bar">
            <span class="perf-bar-tag muted">llama</span>
            <div class="perf-track"><i class="perf-fill baseline" style={`width:${barPct(row.baselineDecode, rdnaBoard.decodeMax)}%`}></i></div>
            <span class="perf-bar-val">{formatTok(row.baselineDecode, 1)}</span>
          </div>
          <p class="perf-prefill">
            Prefill <strong>{formatTok(row.zincPrefill, 0)}</strong> ZINC · {formatTok(row.baselinePrefill, 0)} llama.cpp · Overall <strong>{formatPercent(row.overallPct)}</strong>
          </p>
        </article>
      ))}
    </div>
    <p class="perf-caption">Each result uses reusable ZINC and llama.cpp servers on the same GPU, with the same GGUF file, prompts, warmup count, and measured run count. The <a href="/zinc/benchmarks/">benchmark page</a> includes every scenario and the exact run configuration.</p>
  </section>

  <section class="start-panel" aria-label="ZINC documentation links">
    <div class="start-links">
      <a href="/zinc/docs/getting-started/">Getting Started</a>
      <a href="/zinc/docs/hardware-requirements/">Hardware Requirements</a>
      <a href="/zinc/docs/running-zinc/">Running ZINC</a>
      <a href="/zinc/docs/">All Docs</a>
    </div>
  </section>

  <section>
    <p>ZINC loads GGUF files directly and runs them on a local GPU. AMD users can choose Vulkan or ROCm; the two builds and their benchmark results are kept separate. Intel Arc uses Vulkan, Apple Silicon uses Metal, and NVIDIA support is being developed through CUDA.</p>

    <p>The project is under active development. The command-line path and the listed models receive the most testing. Model coverage and performance are not yet equal across every backend, so the benchmark page shows incomplete and failed rows as well as successful ones.</p>

    <h2>Why another engine?</h2>

    <table>
      <thead>
        <tr><th></th><th>ZINC</th><th>Typical datacenter stack</th><th>General local stack</th></tr>
      </thead>
      <tbody>
        <tr><td><strong>Main use</strong></td><td>Local inference on consumer GPUs</td><td>Larger CUDA/ROCm servers</td><td>Local inference on many kinds of hardware</td></tr>
        <tr><td><strong>Backends</strong></td><td>Vulkan, ROCm, Metal, CUDA experiments</td><td>CUDA/ROCm first</td><td>CPU plus many GPU backends</td></tr>
        <tr><td><strong>AMD RDNA</strong></td><td>Vulkan and ROCm</td><td>ROCm</td><td>Several available backends</td></tr>
        <tr><td><strong>Apple Silicon</strong></td><td>Native Metal backend</td><td>Not the target</td><td>Mature Metal path</td></tr>
        <tr><td><strong>NVIDIA RTX</strong></td><td>Experimental CUDA path</td><td>Primary target</td><td>Mature CUDA path</td></tr>
        <tr><td><strong>KV cache compression</strong></td><td>TurboQuant roadmap / experimental path</td><td>No</td><td>No</td></tr>
        <tr><td><strong>OpenAI API</strong></td><td>Native</td><td>Native</td><td>Via server wrapper</td></tr>
      </tbody>
    </table>

    <h2>Other measured targets</h2>

    <p>The AMD board above shows the Vulkan sweep. The <a href="/zinc/benchmarks/#rdna-rocm">benchmarks dashboard</a> adds the independently measured ROCm suite and lets you switch between the two AMD backends, alongside Intel Arc, Apple Silicon, and NVIDIA CUDA data.</p>

    <h3 class="perf-heading">Apple Silicon — Mac Studio (M4 Max) <span class="perf-sub">40-core GPU · 64 GB unified · {formatRefreshDate(metalTarget?.generated_at)}</span></h3>
    <div class="perf-board" role="img" aria-label="ZINC vs llama.cpp decode throughput on Apple M4 Max">
      <div class="perf-board-legend">
        <span><i class="perf-swatch zinc"></i>ZINC</span>
        <span><i class="perf-swatch baseline"></i>llama.cpp</span>
        <span class="perf-board-note">decode tok/s · higher is better</span>
      </div>
      {metalBoard.rows.map((row) => (
        <article class="perf-bench-row">
          <div class="perf-bench-head">
            <strong>{row.label}</strong>
            <span class:list={['perf-ratio', ratioTone(row.zincDecode, row.baselineDecode)]}>{formatRatioX(row.zincDecode, row.baselineDecode)} llama.cpp</span>
          </div>
          <div class="perf-bar">
            <span class="perf-bar-tag">ZINC</span>
            <div class="perf-track"><i class="perf-fill zinc" style={`width:${barPct(row.zincDecode, metalBoard.decodeMax)}%`}></i></div>
            <span class="perf-bar-val">{formatTok(row.zincDecode, 1)}</span>
          </div>
          <div class="perf-bar">
            <span class="perf-bar-tag muted">llama</span>
            <div class="perf-track"><i class="perf-fill baseline" style={`width:${barPct(row.baselineDecode, metalBoard.decodeMax)}%`}></i></div>
            <span class="perf-bar-val">{formatTok(row.baselineDecode, 1)}</span>
          </div>
          <p class="perf-prefill">Prefill <strong>{formatTok(row.zincPrefill, 0)}</strong> ZINC · {formatTok(row.baselinePrefill, 0)} llama.cpp</p>
        </article>
      ))}
    </div>
    <p class="perf-caption">These results come from the Mac Studio listed above; they are not an average across Apple devices. Metal performance still varies by model, and the complete rows are available on the benchmark page.</p>

    <h2>What ZINC does</h2>

    <p>ZINC has separate GPU implementations for Vulkan, ROCm/HIP, Metal, and CUDA. On AMD, choose the backend when you build. Intel uses Vulkan, Apple Silicon uses <a href="/zinc/docs/apple-metal-reference/">Metal</a>, and NVIDIA uses the experimental CUDA build.</p>

    <p>The server provides <code>POST /v1/chat/completions</code>, streaming responses, and a built-in chat page. Existing clients can use the <a href="/zinc/docs/api/">OpenAI-compatible API</a>.</p>

    <p>Models load from memory-mapped GGUF files. Current quantization support includes Q4_K, Q5_K, Q6_K, Q8_0, and F16. The tested model families are listed in the <a href="/zinc/docs/running-zinc/">model guide</a>.</p>

    <p>ZINC is written in Zig and builds as one binary. The Metal backend uses a small Objective-C shim.</p>

    <h2>Architecture</h2>

    <div class="arch-diagram">
      <img src="/zinc-architecture.svg" alt="ZINC LLM inference engine architecture with native GPU backends for Vulkan, ROCm, Metal, and CUDA" width="680" />
    </div>

    <h2>Supported hardware: consumer GPU targets</h2>

    <p>AMD Radeon, Intel Arc, and Apple Silicon are supported. NVIDIA CUDA is experimental. The cards below are the models currently used for development and testing.</p>

    <h3>AMD Radeon GPUs — RDNA4 &amp; RDNA3 (Linux)</h3>
    <ul>
      <li><strong>RDNA4</strong>: RX 9070, RX 9070 XT, Radeon AI PRO R9700 (primary tuning target)</li>
      <li><strong>RDNA3</strong>: RX 7900 XTX, RX 7900 XT, RX 7800 XT, RX 7700 XT, RX 7600</li>
    </ul>
    <p>Use Vulkan 1.3 with RADV/AMDVLK for the broad AMD path, or build with <code>-Dbackend=rocm</code> on a supported ROCm installation. The current ROCm reference stack is validated on RDNA4 <code>gfx1201</code>.</p>

    <h3>Apple Silicon (macOS)</h3>
    <ul>
      <li><strong>M1 through M5</strong>: all variants (base, Pro, Max, Ultra)</li>
      <li>Current public reference box: Mac Studio (M4 Max, 40-core GPU, 64 GB unified memory)</li>
      <li>Native Metal shaders, zero-copy model loading, unified memory</li>
      <li>16 GB for 2B models, 24+ GB for 35B models</li>
    </ul>

    <h3>NVIDIA RTX GPUs — CUDA (experimental)</h3>
    <ul>
      <li>Current public reference: GeForce RTX 5090, with RTX 4090 also used for backend bring-up</li>
      <li>Native CUDA backend work is measured in the dashboard but still younger than the RDNA path</li>
      <li>Primary target: local GGUF inference on consumer RTX cards where Vulkan is not the practical path</li>
    </ul>

    <h3>Intel Arc — Xe2 / Battlemage (Linux Vulkan)</h3>
    <ul>
      <li>Official support target: Arc B-series / Battlemage class GPUs</li>
      <li>Current public benchmark node completes four managed catalog rows</li>
      <li>Arc-specific performance tuning is still younger than the RDNA4 path</li>
    </ul>

    <p>See the full <a href="/zinc/docs/hardware-requirements/">hardware requirements</a> page for details.</p>

    <hr />
    <p><a href="/zinc/docs/">Documentation</a> · <a href="/zinc/docs/turboquant-spec/">TurboQuant spec</a> · <a href="https://github.com/zolotukhin/zinc">GitHub</a></p>
  </section>
