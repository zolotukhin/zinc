/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# This JSON search endpoint is fetched by the docs UI. It is not a standalone
# search result, so keep crawlers from treating it as a thin indexable page.
/zinc/docs/search
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: noindex, nofollow

# Machine-readable exports and executable downloads stay available to clients
# and crawlers; their HTML guides are the intended web search results.
# Do not block these in robots.txt: crawlers must be able to read noindex.
/zinc/benchmarks.json
  X-Robots-Tag: noindex

/zinc/harnesses/*.mjs
  X-Robots-Tag: noindex

/zinc/validation/*.json
  X-Robots-Tag: noindex

/zinc/docs/zig-api.json
  X-Robots-Tag: noindex

/zinc/docs/zig-api.txt
  X-Robots-Tag: noindex

/llms.txt
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex
