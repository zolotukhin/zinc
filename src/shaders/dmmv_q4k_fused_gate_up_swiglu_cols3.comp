#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

// Fused Q4_K gate + up + SwiGLU for tiny token batches (NextN/MTP
// verification, 2-4 columns). Combines dmmv_q4k_fused_gate_up_swiglu.comp
// (one weight stream feeds both projections and the activation) with the
// column layout of dmmv_q4k_rows4_cols.comp (activations [num_cols][K] loaded
// once per block and applied to every column). Output is [num_cols][M].
layout(local_size_x = 64) in;

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint a_offset;
    uint x_offset;
    uint y_offset;
    uint num_cols;
};

layout(set = 0, binding = 0) readonly buffer MatrixAGate { uint a_gate_u32[]; };
layout(set = 0, binding = 1) readonly buffer MatrixAUp   { uint a_up_u32[];   };
layout(set = 0, binding = 2) readonly buffer VectorX     { vec4 x_v4[];       };
layout(set = 0, binding = 3) writeonly buffer Swiglu     { float swiglu[];    };

const uint NUM_ROWS = 2u;
const uint MAX_COLS = 3u;  // three-column, unguarded variant
const uint Q4K_BLOCK_U32 = 36u;  // 144 bytes / 4

shared float s_sg_gate[4];
shared float s_sg_up[4];

vec4 unpack_nibbles_lo(uint v) {
    return vec4(float(v & 0xFu), float((v >> 8) & 0xFu),
                float((v >> 16) & 0xFu), float((v >> 24) & 0xFu));
}
vec4 unpack_nibbles_hi(uint v) {
    return vec4(float((v >> 4) & 0xFu), float((v >> 12) & 0xFu),
                float((v >> 20) & 0xFu), float((v >> 28) & 0xFu));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;
    const uint THREADS_PER_BLOCK = 16u;
    const uint it_size = 64u / THREADS_PER_BLOCK;  // 4 blocks in flight per workgroup
    uint itid = tid % THREADS_PER_BLOCK;
    uint ix = tid / THREADS_PER_BLOCK;
    uint il = itid / 4u;
    uint ir = itid % 4u;
    uint v_im = il / 2u;
    uint v_in = il % 2u;
    uint l0 = 4u * (2u * ir + v_in);
    uint q_offset = 32u * v_im + l0;
    uint y_offset_local = 64u * v_im + l0;
    uint shift = v_im * 16u;
    uint x_base = x_offset / 16u;
    uint y_base = y_offset / 4u;
    uint blocks_per_row = K / 256u;
    uint a_base = a_offset / 4u;
    uint x_col_stride_v4 = K / 4u;

    uint row_base = wg_id * NUM_ROWS;
    if (row_base >= M) return;

    float sum_gate[NUM_ROWS][MAX_COLS];
    float sum_up[NUM_ROWS][MAX_COLS];
    [[unroll]] for (uint r = 0u; r < NUM_ROWS; r++) {
        [[unroll]] for (uint c = 0u; c < MAX_COLS; c++) {
            sum_gate[r][c] = 0.0;
            sum_up[r][c] = 0.0;
        }
    }

    for (uint i = ix; i < blocks_per_row; i += it_size) {
        uint b_idx = (i * 256u + y_offset_local) / 4u;
        uint b_idx2 = (i * 256u + y_offset_local + 128u) / 4u;
        vec4 by[MAX_COLS][4];
        [[unroll]] for (uint c = 0u; c < MAX_COLS; c++) {
            uint cb = x_base + c * x_col_stride_v4;
            by[c][0] = x_v4[cb + b_idx];
            by[c][1] = x_v4[cb + b_idx + 8u];
            by[c][2] = x_v4[cb + b_idx2];
            by[c][3] = x_v4[cb + b_idx2 + 8u];
        }
        [[unroll]] for (uint r = 0u; r < NUM_ROWS; r++) {
            uint row = row_base + r;
            // M % NUM_ROWS == 0 and num_cols == MAX_COLS are guaranteed by the host.
            uint blk_u32 = a_base + row * blocks_per_row * Q4K_BLOCK_U32 + i * Q4K_BLOCK_U32;
            {
                uint d_dmin = a_gate_u32[blk_u32];
                float d_val = unpackHalf2x16(d_dmin & 0xFFFFu).x;
                float dmin_val = unpackHalf2x16(d_dmin >> 16).x;
                uint sc0 = a_gate_u32[blk_u32 + 1u];
                uint sc1 = a_gate_u32[blk_u32 + 2u];
                uint sc2 = a_gate_u32[blk_u32 + 3u];
                uint qs_u32_0 = a_gate_u32[blk_u32 + 4u + q_offset / 4u];
                uint qs_u32_1 = a_gate_u32[blk_u32 + 4u + q_offset / 4u + 16u];
                vec4 q0_lo = unpack_nibbles_lo(qs_u32_0);
                vec4 q0_hi = unpack_nibbles_hi(qs_u32_0);
                vec4 q1_lo = unpack_nibbles_lo(qs_u32_1);
                vec4 q1_hi = unpack_nibbles_hi(qs_u32_1);
                uint sc0_v = sc0 >> shift;
                uint sc1_v = sc1 >> shift;
                uint sc2_v = sc2 >> shift;
                float sc_a = float(sc0_v & 0x3Fu);
                float mn_a = float(sc1_v & 0x3Fu);
                float sc_b = float((sc0_v >> 8u) & 0x3Fu);
                float mn_b = float((sc1_v >> 8u) & 0x3Fu);
                float sc_c = float((sc2_v & 0xFu) | ((sc0_v & 0xC0u) >> 2u));
                float mn_c = float(((sc2_v & 0xF0u) >> 4u) | ((sc1_v & 0xC0u) >> 2u));
                float sc_d = float(((sc2_v >> 8u) & 0xFu) | (((sc0_v >> 8u) & 0xC0u) >> 2u));
                float mn_d = float((((sc2_v >> 8u) & 0xF0u) >> 4u) | (((sc1_v >> 8u) & 0xC0u) >> 2u));
                vec4 w0 = vec4(d_val * sc_a) * q0_lo - vec4(dmin_val * mn_a);
                vec4 w1 = vec4(d_val * sc_b) * q0_hi - vec4(dmin_val * mn_b);
                vec4 w2 = vec4(d_val * sc_c) * q1_lo - vec4(dmin_val * mn_c);
                vec4 w3 = vec4(d_val * sc_d) * q1_hi - vec4(dmin_val * mn_d);
                [[unroll]] for (uint c = 0u; c < MAX_COLS; c++) {
                    sum_gate[r][c] += dot(w0, by[c][0]) + dot(w1, by[c][1]) + dot(w2, by[c][2]) + dot(w3, by[c][3]);
                }
            }
            {
                uint d_dmin = a_up_u32[blk_u32];
                float d_val = unpackHalf2x16(d_dmin & 0xFFFFu).x;
                float dmin_val = unpackHalf2x16(d_dmin >> 16).x;
                uint sc0 = a_up_u32[blk_u32 + 1u];
                uint sc1 = a_up_u32[blk_u32 + 2u];
                uint sc2 = a_up_u32[blk_u32 + 3u];
                uint qs_u32_0 = a_up_u32[blk_u32 + 4u + q_offset / 4u];
                uint qs_u32_1 = a_up_u32[blk_u32 + 4u + q_offset / 4u + 16u];
                vec4 q0_lo = unpack_nibbles_lo(qs_u32_0);
                vec4 q0_hi = unpack_nibbles_hi(qs_u32_0);
                vec4 q1_lo = unpack_nibbles_lo(qs_u32_1);
                vec4 q1_hi = unpack_nibbles_hi(qs_u32_1);
                uint sc0_v = sc0 >> shift;
                uint sc1_v = sc1 >> shift;
                uint sc2_v = sc2 >> shift;
                float sc_a = float(sc0_v & 0x3Fu);
                float mn_a = float(sc1_v & 0x3Fu);
                float sc_b = float((sc0_v >> 8u) & 0x3Fu);
                float mn_b = float((sc1_v >> 8u) & 0x3Fu);
                float sc_c = float((sc2_v & 0xFu) | ((sc0_v & 0xC0u) >> 2u));
                float mn_c = float(((sc2_v & 0xF0u) >> 4u) | ((sc1_v & 0xC0u) >> 2u));
                float sc_d = float(((sc2_v >> 8u) & 0xFu) | (((sc0_v >> 8u) & 0xC0u) >> 2u));
                float mn_d = float((((sc2_v >> 8u) & 0xF0u) >> 4u) | (((sc1_v >> 8u) & 0xC0u) >> 2u));
                vec4 w0 = vec4(d_val * sc_a) * q0_lo - vec4(dmin_val * mn_a);
                vec4 w1 = vec4(d_val * sc_b) * q0_hi - vec4(dmin_val * mn_b);
                vec4 w2 = vec4(d_val * sc_c) * q1_lo - vec4(dmin_val * mn_c);
                vec4 w3 = vec4(d_val * sc_d) * q1_hi - vec4(dmin_val * mn_d);
                [[unroll]] for (uint c = 0u; c < MAX_COLS; c++) {
                    sum_up[r][c] += dot(w0, by[c][0]) + dot(w1, by[c][1]) + dot(w2, by[c][2]) + dot(w3, by[c][3]);
                }
            }
        }
    }

    [[unroll]] for (uint r = 0u; r < NUM_ROWS; r++) {
        uint row = row_base + r;
        if (row >= M) break;
        [[unroll]] for (uint c = 0u; c < MAX_COLS; c++) {
            if (c < num_cols) {
                float g = subgroupAdd(sum_gate[r][c]);
                float u = subgroupAdd(sum_up[r][c]);
                if (gl_NumSubgroups > 1u) {
                    if (subgroupElect()) {
                        s_sg_gate[gl_SubgroupID] = g;
                        s_sg_up[gl_SubgroupID] = u;
                    }
                    barrier();
                    if (tid == 0u) {
                        for (uint sg = 1u; sg < gl_NumSubgroups; sg++) {
                            g += s_sg_gate[sg];
                            u += s_sg_up[sg];
                        }
                    }
                    barrier();
                }
                if (tid == 0u) {
                    float silu_g = g / (1.0 + exp(-g));
                    swiglu[y_base + c * M + row] = silu_g * u;
                }
            }
        }
    }
}
