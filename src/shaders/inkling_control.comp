#version 460

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer Message { float message[]; };
layout(set = 0, binding = 2, std430) readonly buffer Gain { float gain[]; };
layout(set = 0, binding = 3, std430) readonly buffer Forget { float forget[]; };
layout(push_constant) uniform Params { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) x[i] = fma(tanh(gain[i]), message[i], (1.0 - tanh(forget[i])) * x[i]);
}
