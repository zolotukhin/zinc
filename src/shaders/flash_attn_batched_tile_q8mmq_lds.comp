#version 460
// ZINC — register-tiled causal prefill attention over a q8_0 KV cache with
// the Q·K^T product on the int8 dot instruction (MMQ-style), LDS-staged K/V:
// each 32-key K/V tile is fetched once per workgroup by coalesced cooperative
// loads (thread = (key, block), 9 contiguous uints each) instead of once per
// wave by 36-byte per-lane gathers. The per-lane math and accumulation order
// are unchanged, so outputs are bit-identical to flash_attn_batched_tile_q8mmq.
//
// Same tiling as flash_attn_batched_tile (4 waves x 4 (query, head) rows, 32
// key columns per step, an 8x8 lane grid per wave, per-lane online softmax
// merged once at the end). Two things differ:
//   - A lane owns one 32-element block of the head dimension (dim-lane d_tid
//     owns block d_tid) instead of one vec4 of every block. A q8 block is 8
//     packed uints and one f16 scale, so the lane's K slice for a column is
//     8 contiguous uints and its own scale.
//   - Q is quantized once per (row, block) into int8 in LDS (the attention
//     scale folded in). The score partial for a (row, column) on this lane is
//     8 dotPacked4x8 instructions — 32 multiply-adds — times the two block
//     scales, against 32 f32 FMAs before. The 8 dim-lanes' partials are summed
//     by the same butterfly as the f32 kernel.
// The PV side stays f32: V blocks are dequantized to vec4 and accumulated in
// f32 per (row, 32-dim slice).
//
// Requires head_dim 256. Dispatch: grid.x = n_kv_heads,
// grid.y = ceil(gqa * n_queries / 16), local_size_x = 256.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#include "dp4a_compat.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
    uint head_dim;
    uint n_heads;
    uint n_kv_heads;
    uint seq_start;
    uint n_queries;
    uint page_size;
    uint attn_scale_bits;
    uint sink_offset;
};

layout(set = 0, binding = 0) readonly  buffer Query     { float q_data[];    };
layout(set = 0, binding = 0) readonly  buffer QueryV4   { vec4  q_data_v4[]; };
layout(set = 0, binding = 1) readonly  buffer KCacheV4  { uint  k_data_u[];  };
layout(set = 0, binding = 2) readonly  buffer VCacheV4  { uint  v_data_u[];  };
layout(set = 0, binding = 3) readonly  buffer PageTable { uint  page_ids[];  };
layout(set = 0, binding = 4) writeonly buffer Output    { float o_data[];    };
layout(set = 0, binding = 4) writeonly buffer OutputV4  { vec4  o_data_v4[]; };
layout(set = 0, binding = 5) readonly  buffer Sinks     { float sink_data[]; };

const uint WAVES = 4u;
const uint ROWS = 4u;
const uint WG_ROWS = WAVES * ROWS;   // 16
const uint D_SPLIT = 8u;             // dim-lanes per column = blocks per 256-wide row
const uint BLOCKS = 8u;
const uint HEAD_DIM_V4 = 64u;
const uint COL_GROUPS = 8u;
const uint COLS = 4u;
const uint BC = COL_GROUPS * COLS;   // 32
const float NEG_HALF_MAX = -1.7e38;

shared uint  s_qi8[WG_ROWS * BLOCKS * 8u];  // 4 KB: int8 Q, [row][block][uint]
shared uint  s_k[BC * BLOCKS * 9u];         // 9 KB: this step's K tile, [key][block][9 uints]
shared uint  s_v[BC * BLOCKS * 9u];         // 9 KB: this step's V tile
shared float s_qs[WG_ROWS * BLOCKS];        // Q block scales (attention scale folded in)

void main() {
    const uint kv_head = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;
    const uint wave = tid / 64u;
    const uint lane = tid % 64u;
    const uint d_tid = lane % D_SPLIT;      // this lane's block of the head dim
    const uint col_tid = lane / D_SPLIT;
    const uint gqa = n_heads / n_kv_heads;
    const uint head0 = kv_head * gqa;
    const uint total_rows = gqa * n_queries;
    const uint wg_row_base = gl_WorkGroupID.y * WG_ROWS;
    const uint row_base = wg_row_base + wave * ROWS;
    const float scale = attn_scale_bits != 0u ? uintBitsToFloat(attn_scale_bits) : inversesqrt(float(head_dim));
    const float neg_inf = uintBitsToFloat(0xff800000u);

    uint row_q[ROWS];
    uint row_head[ROWS];
    uint row_qp[ROWS];
    bool row_valid[ROWS];
    uint max_qp = 0u;
    for (uint r = 0u; r < ROWS; r++) {
        const uint rg = row_base + r;
        row_valid[r] = rg < total_rows;
        const uint rr = row_valid[r] ? rg : 0u;
        row_q[r] = rr / gqa;
        row_head[r] = head0 + (rr % gqa);
        row_qp[r] = seq_start + row_q[r];
        max_qp = max(max_qp, row_qp[r]);
    }

    // Quantize Q: lanes 0..127 each take one (row, block) of the workgroup's 16 rows.
    if (tid < WG_ROWS * BLOCKS) {
        const uint sr = tid / BLOCKS;
        const uint blk = tid % BLOCKS;
        const uint rg = wg_row_base + sr;
        vec4 qv[8];
        float amax = 0.0;
        if (rg < total_rows) {
            const uint sq = rg / gqa;
            const uint sh = head0 + (rg % gqa);
            const uint qb = ((sq * n_heads + sh) * head_dim >> 2) + blk * 8u;
            for (uint u = 0u; u < 8u; u++) {
                qv[u] = q_data_v4[qb + u] * scale;
                const vec4 a = abs(qv[u]);
                amax = max(amax, max(max(a.x, a.y), max(a.z, a.w)));
            }
        } else {
            for (uint u = 0u; u < 8u; u++) qv[u] = vec4(0.0);
        }
        const float d = amax / 127.0;
        const float d_inv = (d != 0.0) ? (1.0 / d) : 0.0;
        for (uint u = 0u; u < 8u; u++) {
            const i8vec4 q = i8vec4(round(qv[u] * d_inv));
            s_qi8[(sr * BLOCKS + blk) * 8u + u] = uint(uint8_t(q.x)) | (uint(uint8_t(q.y)) << 8) | (uint(uint8_t(q.z)) << 16) | (uint(uint8_t(q.w)) << 24);
        }
        s_qs[sr * BLOCKS + blk] = d;
    }
    barrier();
    const uint q_row0 = wave * ROWS;

    // Per-row, this lane's block: 8 packed uints + scale, kept in registers.
    int qa0[8]; int qa1[8]; int qa2[8]; int qa3[8];
    for (uint u = 0u; u < 8u; u++) {
        qa0[u] = int(s_qi8[((q_row0 + 0u) * BLOCKS + d_tid) * 8u + u]);
        qa1[u] = int(s_qi8[((q_row0 + 1u) * BLOCKS + d_tid) * 8u + u]);
        qa2[u] = int(s_qi8[((q_row0 + 2u) * BLOCKS + d_tid) * 8u + u]);
        qa3[u] = int(s_qi8[((q_row0 + 3u) * BLOCKS + d_tid) * 8u + u]);
    }
    const float qs0 = s_qs[(q_row0 + 0u) * BLOCKS + d_tid];
    const float qs1 = s_qs[(q_row0 + 1u) * BLOCKS + d_tid];
    const float qs2 = s_qs[(q_row0 + 2u) * BLOCKS + d_tid];
    const float qs3 = s_qs[(q_row0 + 3u) * BLOCKS + d_tid];

    vec4 Of[ROWS][8];
    float Mf[ROWS];
    float Lf[ROWS];
    for (uint r = 0u; r < ROWS; r++) {
        Mf[r] = NEG_HALF_MAX;
        Lf[r] = 0.0;
        for (uint u = 0u; u < 8u; u++) Of[r][u] = vec4(0.0);
    }

    const uint n_cols_total = max_qp + 1u;
    const uint kv_row_stride_blk = (n_kv_heads * head_dim) >> 5;   // blocks per position
    const uint kv_head_off_blk = (kv_head * head_dim) >> 5;

    // Cooperative staging: thread tid loads key (tid / 8), block (tid % 8).
    const uint ld_key = tid / BLOCKS;
    const uint ld_blk = tid % BLOCKS;
    for (uint j = 0u; j < n_cols_total; j += BC) {
        barrier();   // previous step's readers are done with s_k / s_v
        {
            const uint pos = j + ld_key;
            const uint p = (pos < n_cols_total) ? pos : 0u;   // masked columns read a finite row
            const uint page_id = page_ids[p / page_size];
            const uint row_blk = (page_id * page_size + (p % page_size)) * kv_row_stride_blk + kv_head_off_blk;
            const uint src = (row_blk + ld_blk) * 9u;
            const uint dst = (ld_key * BLOCKS + ld_blk) * 9u;
            for (uint i = 0u; i < 9u; i++) {
                s_k[dst + i] = k_data_u[src + i];
                s_v[dst + i] = v_data_u[src + i];
            }
        }
        barrier();
        uint kbase[COLS];    // uint index of this lane's block in the staged tile
        uint kpos[COLS];
        bool kvalid[COLS];
        for (uint c = 0u; c < COLS; c++) {
            const uint pos = j + c * COL_GROUPS + col_tid;
            kpos[c] = pos;
            kvalid[c] = pos < n_cols_total;
            kbase[c] = ((c * COL_GROUPS + col_tid) * BLOCKS + d_tid) * 9u;
        }

        // Scores: int8 dot over this lane's block, times both block scales.
        float Sf[ROWS][COLS];
        for (uint c = 0u; c < COLS; c++) {
            const uint kb = kbase[c];
            const int k0 = int(s_k[kb]);
            const int k1 = int(s_k[kb + 1u]);
            const int k2 = int(s_k[kb + 2u]);
            const int k3 = int(s_k[kb + 3u]);
            const int k4 = int(s_k[kb + 4u]);
            const int k5 = int(s_k[kb + 5u]);
            const int k6 = int(s_k[kb + 6u]);
            const int k7 = int(s_k[kb + 7u]);
            const float ks = unpackHalf2x16(s_k[kb + 8u]).x;
            int i0 = 0, i1 = 0, i2 = 0, i3 = 0;
            i0 = dotPacked4x8AccSatEXT(qa0[0], k0, i0); i0 = dotPacked4x8AccSatEXT(qa0[1], k1, i0);
            i0 = dotPacked4x8AccSatEXT(qa0[2], k2, i0); i0 = dotPacked4x8AccSatEXT(qa0[3], k3, i0);
            i0 = dotPacked4x8AccSatEXT(qa0[4], k4, i0); i0 = dotPacked4x8AccSatEXT(qa0[5], k5, i0);
            i0 = dotPacked4x8AccSatEXT(qa0[6], k6, i0); i0 = dotPacked4x8AccSatEXT(qa0[7], k7, i0);
            i1 = dotPacked4x8AccSatEXT(qa1[0], k0, i1); i1 = dotPacked4x8AccSatEXT(qa1[1], k1, i1);
            i1 = dotPacked4x8AccSatEXT(qa1[2], k2, i1); i1 = dotPacked4x8AccSatEXT(qa1[3], k3, i1);
            i1 = dotPacked4x8AccSatEXT(qa1[4], k4, i1); i1 = dotPacked4x8AccSatEXT(qa1[5], k5, i1);
            i1 = dotPacked4x8AccSatEXT(qa1[6], k6, i1); i1 = dotPacked4x8AccSatEXT(qa1[7], k7, i1);
            i2 = dotPacked4x8AccSatEXT(qa2[0], k0, i2); i2 = dotPacked4x8AccSatEXT(qa2[1], k1, i2);
            i2 = dotPacked4x8AccSatEXT(qa2[2], k2, i2); i2 = dotPacked4x8AccSatEXT(qa2[3], k3, i2);
            i2 = dotPacked4x8AccSatEXT(qa2[4], k4, i2); i2 = dotPacked4x8AccSatEXT(qa2[5], k5, i2);
            i2 = dotPacked4x8AccSatEXT(qa2[6], k6, i2); i2 = dotPacked4x8AccSatEXT(qa2[7], k7, i2);
            i3 = dotPacked4x8AccSatEXT(qa3[0], k0, i3); i3 = dotPacked4x8AccSatEXT(qa3[1], k1, i3);
            i3 = dotPacked4x8AccSatEXT(qa3[2], k2, i3); i3 = dotPacked4x8AccSatEXT(qa3[3], k3, i3);
            i3 = dotPacked4x8AccSatEXT(qa3[4], k4, i3); i3 = dotPacked4x8AccSatEXT(qa3[5], k5, i3);
            i3 = dotPacked4x8AccSatEXT(qa3[6], k6, i3); i3 = dotPacked4x8AccSatEXT(qa3[7], k7, i3);
            Sf[0][c] = float(i0) * (qs0 * ks);
            Sf[1][c] = float(i1) * (qs1 * ks);
            Sf[2][c] = float(i2) * (qs2 * ks);
            Sf[3][c] = float(i3) * (qs3 * ks);
        }
        for (uint c = 0u; c < COLS; c++) {
            for (uint r = 0u; r < ROWS; r++) {
                float v = Sf[r][c];
                v += subgroupShuffleXor(v, 4u);
                v += subgroupShuffleXor(v, 2u);
                v += subgroupShuffleXor(v, 1u);
                Sf[r][c] = v;
            }
        }
        for (uint r = 0u; r < ROWS; r++)
            for (uint c = 0u; c < COLS; c++)
                if (!kvalid[c] || kpos[c] > row_qp[r]) Sf[r][c] = neg_inf;

        float eM[ROWS];
        bool max_changed = false;
        for (uint r = 0u; r < ROWS; r++) {
            float rowmax = NEG_HALF_MAX;
            for (uint c = 0u; c < COLS; c++) rowmax = max(rowmax, Sf[r][c]);
            const float m_new = max(Mf[r], rowmax);
            max_changed = max_changed || (m_new > Mf[r]);
            eM[r] = exp(Mf[r] - m_new);
            Mf[r] = m_new;
            Lf[r] *= eM[r];
        }
        // Deep into a sequence the running max rarely moves; when no row of
        // this wave moved, every correction is exactly 1 and the rescale of
        // the 32 accumulator vec4s is skipped (wave-uniform branch, exact).
        if (subgroupAny(max_changed)) {
            for (uint u = 0u; u < 8u; u++)
                for (uint r = 0u; r < ROWS; r++) Of[r][u] *= eM[r];
        }

        // PV: this lane's 32-dim slice of V for each column, dequantized to f32.
        for (uint c = 0u; c < COLS; c++) {
            const float p0 = exp(Sf[0][c] - Mf[0]);
            const float p1 = exp(Sf[1][c] - Mf[1]);
            const float p2 = exp(Sf[2][c] - Mf[2]);
            const float p3 = exp(Sf[3][c] - Mf[3]);
            Lf[0] += p0; Lf[1] += p1; Lf[2] += p2; Lf[3] += p3;
            const uint vb = kbase[c];
            const float vs = 127.0 * unpackHalf2x16(s_v[vb + 8u]).x;
            for (uint u = 0u; u < 8u; u++) {
                const vec4 v = vec4(unpackSnorm4x8(s_v[vb + u])) * vs;
                Of[0][u] += p0 * v;
                Of[1][u] += p1 * v;
                Of[2][u] += p2 * v;
                Of[3][u] += p3 * v;
            }
        }
    }

    // Merge the 8 column groups (xor 8, 16, 32) — dim-lanes keep their own block.
    for (uint r = 0u; r < ROWS; r++) {
        float m = Mf[r];
        m = max(m, subgroupShuffleXor(m, 8u));
        m = max(m, subgroupShuffleXor(m, 16u));
        m = max(m, subgroupShuffleXor(m, 32u));
        const float sc = exp(Mf[r] - m);
        Mf[r] = m;
        float l = Lf[r] * sc;
        l += subgroupShuffleXor(l, 8u);
        l += subgroupShuffleXor(l, 16u);
        l += subgroupShuffleXor(l, 32u);
        Lf[r] = l;
        for (uint u = 0u; u < 8u; u++) {
            vec4 o = Of[r][u] * sc;
            o += subgroupShuffleXor(o, 8u);
            o += subgroupShuffleXor(o, 16u);
            o += subgroupShuffleXor(o, 32u);
            Of[r][u] = o;
        }
    }

    if (col_tid == 0u) {
        for (uint r = 0u; r < ROWS; r++) {
            if (!row_valid[r]) continue;
            const float sink_val = sink_data[sink_offset + row_head[r]];
            float final_sum = Lf[r];
            float out_rescale = 1.0;
            if (!isnan(sink_val)) {
                const float sink_max = max(Mf[r], sink_val);
                out_rescale = exp(Mf[r] - sink_max);
                final_sum = Lf[r] * out_rescale + exp(sink_val - sink_max);
            }
            const float f = out_rescale * (final_sum > 0.0 ? 1.0 / final_sum : 0.0);
            const uint ob = ((row_q[r] * n_heads + row_head[r]) * head_dim) >> 2;
            for (uint u = 0u; u < 8u; u++) {
                o_data_v4[ob + d_tid * 8u + u] = Of[r][u] * f;
            }
        }
    }
}
