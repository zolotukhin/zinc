#version 460

layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer GateUp { float gate_up[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { float hidden[]; };
layout(push_constant) uniform Params { uint width; float beta; float linear_beta; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.width) return;
    uint base = gl_WorkGroupID.y * p.width;
    float gate = gate_up[2u * base + i];
    float up = gate_up[2u * base + p.width + i];
    hidden[base + i] = p.beta * tanh(gate / p.beta) / (1.0 + exp(-gate)) *
        p.linear_beta * tanh(up / p.linear_beta);
}
